// Housekeeping

function housekeeping_() {
  expireSeen_();
  var logs = getSheet_(SHEETS.LOGS);
  var max = 8000;
  if (logs.getLastRow() > max + 1000) {
    // Keep cost rows for this month (budget math) by only trimming entries older than 40 days.
    var n = logs.getLastRow() - 1;
    var dates = logs.getRange(2, 1, n, 1).getValues();
    var cutoff = nowMs_() - 40 * 86400000, del = 0;
    while (del < n - max && dates[del][0] instanceof Date && dates[del][0].getTime() < cutoff) del++;
    if (del) logs.deleteRows(2, del);
  }
  var proj = projectedMonthCost_('apify'), projC = projectedMonthCost_('claude');
  logEvent_('info', 'housekeeping', 'Yesterday\'s trigger runtime ≈ ' + Math.round(Number(prop_('runtimeYesterday') || 0) / 60) + ' min. Projected month: Apify $' + proj + ' (budget $' + settingNum_('APIFY_MONTHLY_BUDGET') + '), Claude $' + projC +
    ' (budget $' + settingNum_('CLAUDE_MONTHLY_BUDGET') + '); queue ' + queueLength_());
}


// ===== Notify.js =====
/**
 * Notify.js: phone push notifications. ntfy.sh today; add more channels to NOTIFIERS later
 * (e.g. Telegram) without touching the rest of the code.
 *
 * message = {title, body, url, clickUrl, imageUrl, priority (1–5), tags: [], critical: bool}
 */

var NOTIFIERS = {
  ntfy: function (msg) {
    var topic = prop_(PROP.NTFY_TOPIC);
    if (!topic) throw new Error('NTFY_TOPIC Script Property is not set');
    var server = (prop_(PROP.NTFY_SERVER) || 'https://ntfy.sh').replace(/\/+$/, '');
    // JSON publishing (https://docs.ntfy.sh/publish/#publish-as-json) keeps emoji/UTF-8 titles intact.
    var body = {
      topic: topic,
      title: msg.title || 'Deal Finder',
      message: msg.body || '',
      priority: msg.priority || 3,
      markdown: true
    };
    if (msg.tags && msg.tags.length) body.tags = msg.tags;
    if (msg.clickUrl) body.click = msg.clickUrl;
    if (msg.imageUrl) body.attach = msg.imageUrl;
    var actions = [];
    if (msg.url) actions.push({ action: 'view', label: 'Listing', url: msg.url });
    if (msg.dashboardUrl) actions.push({ action: 'view', label: 'Dashboard', url: msg.dashboardUrl });
    if (actions.length) body.actions = actions;
    var headers = {};
    var token = prop_(PROP.NTFY_TOKEN);
    if (token) headers['Authorization'] = 'Bearer ' + token;
    var resp = http_(server, {
      method: 'post', contentType: 'application/json', payload: JSON.stringify(body), headers: headers
    }, 1);
    if (resp.code >= 300) throw new Error('ntfy HTTP ' + resp.code + ': ' + truncate_(resp.text, 200));
  }
};

/**
 * Send a push. Non-critical messages during quiet hours are held and released after quiet hours.
 * Returns 'sent' | 'held' | 'failed'.
 */
function notify_(msg) {
  if (!msg.critical && isQuietHours_()) {
    holdNotification_(msg);
    return 'held';
  }
  var ok = false;
  Object.keys(NOTIFIERS).forEach(function (name) {
    try { NOTIFIERS[name](msg); ok = true; } catch (e) { logEvent_('error', 'notify:' + name, e.message); }
  });
  return ok ? 'sent' : 'failed';
}

function holdNotification_(msg) {
  var held = JSON.parse(prop_('heldNotifications') || '[]');
  held.push(msg);
  setProp_('heldNotifications', JSON.stringify(held.slice(-20)));
}

/** Called from the tick: after quiet hours, send held pushes as one summary. */
function releaseHeldNotifications_() {
  if (isQuietHours_()) return;
  var held = JSON.parse(prop_('heldNotifications') || '[]');
  if (!held.length) return;
  setProp_('heldNotifications', '[]');
  if (held.length === 1) { notify_(held[0]); return; }
  var body = held.map(function (m) { return '• ' + m.title; }).join('\n');
  notify_({ title: held.length + ' deals from overnight', body: body, clickUrl: dashboardUrl_(), tags: ['moon'], priority: 3 });
}

/** Push for a scored deal. */
function notifyDeal_(item) {
  var free = item.price === 0;
  var parts = [
    'Score ' + item.opportunity_score + '/10 · ' + (free ? 'FREE' : '$' + item.price),
    'Est profit $' + Math.round(item.est_profit || 0) + (item.distance_miles !== null && item.distance_miles !== undefined ? ' · ' + item.distance_miles + ' mi' : ''),
    item.reasoning || ''
  ];
  return notify_({
    title: (free ? '🆓 ' : '💰 ') + truncate_(item.title, 80),
    body: parts.join('\n'),
    url: item.url,
    clickUrl: dashboardUrl_(item.deal_id) || item.url,
    dashboardUrl: dashboardUrl_(item.deal_id),
    imageUrl: item.image_url,
    priority: item.opportunity_score >= 9 ? 5 : 4,
    tags: [free ? 'free' : 'moneybag', item.source === 'Facebook' ? 'fb' : 'ksl']
  });
}

/** Push an operational alert (blocks, parser failures, budget). Always critical. */
function alert_(title, body) {
  logEvent_('warn', 'alert', title + ': ' + body);
  return notify_({ title: '⚠️ ' + title, body: body, priority: 4, tags: ['warning'], critical: true, clickUrl: getSpreadsheet_().getUrl() });
}

function dashboardUrl_(dealId) {
  var base = prop_(PROP.WEBAPP_URL);
  if (!base) return '';
  var url = base + '?k=' + encodeURIComponent(prop_(PROP.DASHBOARD_KEY));
  if (dealId) url += '&id=' + encodeURIComponent(dealId);
  return url;
}

/** Menu item: send a test push. */
function sendTestPush() {
  var r = notify_({ title: 'Deal Finder test', body: 'If you can read this, phone alerts work. 👍', critical: true, tags: ['white_check_mark'], clickUrl: dashboardUrl_() });
  safeAlert_('Test push: ' + r);
}


// ===== Pipeline.js =====
/**
 * Pipeline.js: Queue → rule filter → distance → AI filter → (KSL detail) → valuation → score → Deals → push.
 *
 * Normalized item shape (all sources):
 * {deal_id, source: 'Facebook'|'KSL'|'KSL (baseline)'|'Share', listing_id, title, price (0 = free, null = unknown),
 *  city, state, zip, lat, lng, url, image_url, image_urls[], description, posted_at (ISO), category_hint,
 *  matched_search, condition, baseline (bool)}
 *
 * Queue stages: new → filtered → (detail) → done (row removed).
 */

var TICK_BUDGET_MS = 4.5 * 60 * 1000;

/** Process queued items until the batch size or time budget runs out. */
function processQueue_(startedAt) {
  var batch = Math.max(1, settingNum_('QUEUE_BATCH') || 15);
  var entries = readQueue_(batch * 2);
  if (!entries.length) return 0;
  var done = [];
  var processed = 0;

  // Stage "new": rule filter, distance, then one AI filter call for the survivors.
  var fresh = entries.filter(function (e) { return e.stage === 'new' && e.item; });
  var bad = entries.filter(function (e) { return !e.item; });
  bad.forEach(function (e) { done.push(e.row); });
  var toAi = [];
  fresh.forEach(function (e) {
    var it = e.item;
    var reason = ruleFilter_(it);
    if (!reason) {
      it.distance_miles = distanceFromHome_(it);
      if (it.distance_miles !== null && it.distance_miles > settingNum_('TIER3_MI')) reason = 'too far (' + it.distance_miles + ' mi)';
    }
    if (!reason && it.baseline && it.posted_at) {
      var age = (nowMs_() - new Date(it.posted_at).getTime()) / 86400000;
      if (age > settingNum_('KSL_BASELINE_MAX_AGE_DAYS')) reason = 'baseline: older than ' + settingNum_('KSL_BASELINE_MAX_AGE_DAYS') + ' days';
    }
    if (reason) { appendFiltered_(it, reason); done.push(e.row); processed++; }
    else toAi.push(e);
  });

  for (var i = 0; i < toAi.length; i += 20) {
    var chunk = toAi.slice(i, i + 20);
    var verdicts;
    try {
      verdicts = aiFilterBatch_(chunk.map(function (e) { return e.item; }));
    } catch (err) {
      logEvent_('error', 'filter', err.message);
      break; // leave them queued; retry next tick
    }
    chunk.forEach(function (e, j) {
      var v = verdicts[j], it = e.item;
      if (!v.keep) { appendFiltered_(it, 'AI: ' + v.reason); done.push(e.row); processed++; return; }
      it.category = v.category;
      it.quick_resale_guess = v.quick_resale_guess;
      it.needs_detail = v.needs_detail;
      e.stage = 'filtered';
      updateQueueEntry_(e.row, 'filtered', it);
    });
  }

  // Stage "filtered": optional KSL detail fetch, then valuation.
  var ready = entries.filter(function (e) { return e.stage === 'filtered' && e.item && done.indexOf(e.row) < 0; });
  for (var k = 0; k < ready.length && processed < batch; k++) {
    if (nowMs_() - startedAt > TICK_BUDGET_MS) break;
    var e = ready[k], it = e.item;
    try {
      if (/^KSL/.test(it.source) && !it.detail_fetched && wantsKslDetail_(it)) {
        enrichFromKslDetail_(it); // polite fetch; sets detail_fetched even if it fails
      }
      valuateAndRecord_(it);
      done.push(e.row);
      processed++;
    } catch (err) {
      logEvent_('error', 'value', (it.title || it.deal_id) + ': ' + err.message);
      it.attempts = (it.attempts || 0) + 1;
      if (it.attempts >= 3) { appendFiltered_(it, 'error: ' + truncate_(err.message, 120)); done.push(e.row); }
      else updateQueueEntry_(e.row, 'filtered', it);
    }
  }
  removeQueueRows_(done);
  return processed;
}

function wantsKslDetail_(it) {
  if (!settingBool_('KSL_DETAIL_FETCH')) return false;
  if (it.description && it.description.length > 40) return false;
  return detailWorthy_(it) || it.needs_detail;
}

/** Value one item (full or quick), append it to Deals and push if it qualifies. */
function valuateAndRecord_(it) {
  var val = null;
  var quickProfit = (Number(it.quick_resale_guess) || 0) - (Number(it.price) || 0);
  var capOk = dailyCount_('sonnet') < settingNum_('SONNET_DAILY_CAP');
  var budgetOk = monthCost_('claude') < settingNum_('CLAUDE_MONTHLY_BUDGET');
  var worthIt = quickProfit >= settingNum_('SONNET_MIN_QUICK_PROFIT') || it.source === 'Share';

  if (!worthIt) {
    appendFiltered_(it, 'low quick value (resale ~$' + Math.round(it.quick_resale_guess || 0) + ')');
    return;
  }
  if (capOk && budgetOk) {
    var comps = null;
    try { comps = ebayComps_(it.title); } catch (e) { logEvent_('warn', 'ebay', e.message); }
    val = aiValuate_(it, comps);
    bumpDaily_('sonnet');
  } else {
    if (!budgetOk && !prop_('claudeBudgetAlert:' + monthKey_())) {
      setProp_('claudeBudgetAlert:' + monthKey_(), '1');
      alert_('Claude budget reached', 'Month-to-date Claude cost is over $' + settingNum_('CLAUDE_MONTHLY_BUDGET') + '. Using quick estimates only until next month (raise CLAUDE_MONTHLY_BUDGET in Settings to resume).');
    }
    val = quickValuation_(it, capOk ? 'monthly Claude budget reached' : 'daily valuation cap reached');
  }

  Object.keys(val).forEach(function (key) { it[key] = val[key]; });
  var scored = computeScore_(it, val, tiersFromSettings_(), hoursFromSettings_(), getConfig_().weights);
  Object.keys(scored).forEach(function (key) { it[key] = scored[key]; });
  it.ai_score = val.opportunity_score;
  it.opportunity_score = scored.opportunity_score;

  var decision = pushDecision_(it);
  it.notified = decision;
  var row = appendDeal_(it);
  if (decision === 'push') {
    var r = notifyDeal_(it);
    setDealField_(row, 'notified', r === 'sent' ? 'pushed' : r);
  }
}

/** Fallback valuation from the cheap model's quick guess (no extra AI call). */
function quickValuation_(it, why) {
  var guess = Number(it.quick_resale_guess) || 0;
  var profit = guess - (Number(it.price) || 0);
  return {
    item_type: it.category || 'unknown', category: it.category || 'other', brand_model_guess: '', condition_guess: 'unknown', likely_fault: '',
    est_resale_low: Math.round(guess * 0.7), est_resale_high: Math.round(guess), est_parts_cost: 0, est_repair_hours: 1,
    repair_difficulty: 3, pickup_effort: 3, demand: 3,
    opportunity_score: profit >= 300 ? 7 : profit >= 150 ? 6 : profit >= 60 ? 5 : 3,
    reasoning: 'Quick estimate only (' + why + '). Open the listing to judge.'
  };
}

/** 'push' | 'digest' | 'baseline' */
function pushDecision_(it) {
  if (it.baseline) return 'baseline';
  var free = it.price === 0;
  var min = free ? settingNum_('FREE_PUSH_MIN_SCORE') : settingNum_('PAID_PUSH_MIN_SCORE');
  return it.opportunity_score >= min ? 'push' : 'digest';
}


// ===== Scoring.js =====
/**
 * Scoring.js: derived numbers, distance-tier caps, category weights and Sales-log calibration.
 * Pure functions take config explicitly so they can be unit-tested.
 */

/**
 * Combine the AI valuation with deterministic math.
 * tiers = {t1, t2, t3, t2MinProfit, t3MinProfit}; hours = {pickup, listing, mph}; weights = {category: multiplier}
 */
function computeScore_(item, val, tiers, hours, weights) {
  var out = {};
  var low = Math.max(0, Number(val.est_resale_low) || 0);
  var high = Math.max(low, Number(val.est_resale_high) || 0);
  var mid = (low + high) / 2;
  var price = Math.max(0, Number(item.price) || 0);
  var parts = Math.max(0, Number(val.est_parts_cost) || 0);
  var repairHrs = Math.max(0, Number(val.est_repair_hours) || 0);
  var dist = item.distance_miles;

  out.est_profit = Math.round(mid - price - parts);
  var travelHrs = dist ? (2 * dist) / (hours.mph || 40) : 0;
  var totalHrs = repairHrs + (hours.pickup || 0) + (hours.listing || 0) + travelHrs;
  out.profit_per_hour = totalHrs > 0 ? Math.round(out.est_profit / totalHrs) : out.est_profit;
  out.below_market = low > 0 && price < 0.5 * low;

  var score = Number(val.opportunity_score) || 1;
  var w = weights[String(val.category || '').toLowerCase()];
  if (w) score = score * w;
  if (out.est_profit <= 0) score = Math.min(score, 3);

  // Distance tiers
  out.distance_tier = dist === null || dist === undefined ? 1 : dist <= tiers.t1 ? 1 : dist <= tiers.t2 ? 2 : dist <= tiers.t3 ? 3 : 4;
  if (out.distance_tier === 2 && out.est_profit < tiers.t2MinProfit) score = Math.min(score, 6);
  if (out.distance_tier === 3 && out.est_profit < tiers.t3MinProfit) score = Math.min(score, 6);
  if (out.distance_tier === 4) score = 1;

  out.opportunity_score = Math.max(1, Math.min(10, Math.round(score)));
  return out;
}

function tiersFromSettings_() {
  return {
    t1: settingNum_('TIER1_MI'), t2: settingNum_('TIER2_MI'), t3: settingNum_('TIER3_MI'),
    t2MinProfit: settingNum_('TIER2_MIN_PROFIT'), t3MinProfit: settingNum_('TIER3_MIN_PROFIT')
  };
}

function hoursFromSettings_() {
  return { pickup: settingNum_('PICKUP_HOURS'), listing: settingNum_('LISTING_HOURS'), mph: settingNum_('DRIVE_MPH') };
}

// ---------------------------------------------------------------------------
// Sales-log calibration

/** Summarize Sales log rows: per category, actual vs estimated profit and hours. */
function salesCalibration_(rows) {
  var by = {};
  rows.forEach(function (r) {
    var cat = String(r[2] || 'other').toLowerCase();
    var est = Number(r[8]), sale = Number(r[6]), bought = Number(r[3]) || 0, parts = Number(r[4]) || 0;
    if (!sale) return;
    var actual = sale - bought - parts;
    var b = by[cat] || (by[cat] = { n: 0, est: 0, actual: 0, hours: 0 });
    b.n++; b.est += est || 0; b.actual += actual; b.hours += Number(r[5]) || 0;
  });
  return by;
}

function readSalesRows_() {
  var sh = getSheet_(SHEETS.SALES);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, SALES_COLS.length).getValues().filter(function (r) { return r[0] || r[1]; });
}

/** Text appended to the valuation prompt so estimates learn from real sales. */
function calibrationNotes_() {
  var cache = CacheService.getScriptCache();
  var hit = cache.get('calibNotes');
  if (hit !== null) return hit;
  var by = salesCalibration_(readSalesRows_());
  var lines = Object.keys(by).filter(function (k) { return by[k].n >= 2; }).map(function (k) {
    var b = by[k];
    return '- ' + k + ': ' + b.n + ' sold, avg actual profit $' + Math.round(b.actual / b.n) +
      ' vs estimated $' + Math.round(b.est / b.n) + ', avg ' + (Math.round(b.hours / b.n * 10) / 10) + ' h each';
  });
  var notes = lines.length ? '\n\nCalibration from this buyer\'s actual sales (adjust your estimates accordingly):\n' + lines.join('\n') : '';
  cache.put('calibNotes', notes, 3600);
  return notes;
}

/**
 * Menu item: nudge category weights toward categories that actually made money per hour.
 * New weight = old weight × clamp(actual/est profit, 0.8, 1.2), bounded to [0.5, 1.6]. Needs ≥ 3 sales per category.
 */
function recalibrateWeights() {
  var by = salesCalibration_(readSalesRows_());
  var sh = getSheet_(SHEETS.SETTINGS);
  var values = sh.getDataRange().getValues();
  var inW = false, changes = [];
  for (var i = 0; i < values.length; i++) {
    var first = String(values[i][0]).trim();
    if (first.indexOf('## ') === 0) { inW = first === SECTION.WEIGHTS; continue; }
    if (!inW || !first || first === 'Category') continue;
    var b = by[first.toLowerCase()];
    if (!b || b.n < 3 || b.est <= 0) continue;
    var ratio = Math.max(0.8, Math.min(1.2, b.actual / b.est));
    var nw = Math.max(0.5, Math.min(1.6, Math.round(Number(values[i][1]) * ratio * 100) / 100));
    if (nw !== Number(values[i][1])) { sh.getRange(i + 1, 2).setValue(nw); changes.push(first + ' ' + values[i][1] + '→' + nw); }
  }
  CacheService.getScriptCache().remove('calibNotes');
  var msg = changes.length ? 'Updated weights: ' + changes.join(', ') : 'No changes (need at least 3 sales in a category).';
  logEvent_('info', 'recalibrate', msg);
  safeAlert_(msg);
}


