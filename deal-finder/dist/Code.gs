  [PROP.ANTHROPIC_API_KEY, PROP.APIFY_TOKEN, PROP.EBAY_APP_ID, PROP.EBAY_CERT_ID, PROP.NTFY_TOPIC].forEach(function (k) {
    ok(!!prop_(k), k + ' in Script Properties', 'Project Settings → Script Properties');
  });
  if (prop_(PROP.ANTHROPIC_API_KEY)) {
    try {
      var r = http_('https://api.anthropic.com/v1/models/' + settingStr_('MODEL_FILTER'), { headers: { 'x-api-key': prop_(PROP.ANTHROPIC_API_KEY), 'anthropic-version': '2023-06-01' } }, 0);
      ok(r.code === 200, 'Anthropic key works (' + settingStr_('MODEL_FILTER') + ')', 'HTTP ' + r.code);
    } catch (e) { ok(false, 'Anthropic key', e.message); }
  }
  if (prop_(PROP.APIFY_TOKEN)) {
    var a = http_(APIFY_API + '/users/me', { headers: apifyHeaders_() }, 0);
    ok(a.code === 200, 'Apify token works' + (a.json && a.json.data ? ' (' + a.json.data.username + ')' : ''), 'HTTP ' + a.code);
  }
  if (prop_(PROP.EBAY_APP_ID)) ok(!!ebayToken_(), 'eBay keys work', 'check App ID / Cert ID (Production keys)');
  var label = GmailApp.getUserLabelByName(settingStr_('KSL_EMAIL_LABEL'));
  ok(!!label, 'Gmail label "' + settingStr_('KSL_EMAIL_LABEL') + '" exists');
  if (label) ok(label.getThreads(0, 1).length > 0, 'KSL Alerts label has emails');
  ok(!!settingStr_('KSL_ACTOR_ID'), 'KSL_ACTOR_ID set in Settings', 'after apify push');
  ok(!!prop_(PROP.WEBAPP_URL), 'Dashboard deployed (WEBAPP_URL)', 'Deploy → New deployment, then open the dashboard once');
  var trig = ScriptApp.getProjectTriggers().map(function (t) { return t.getHandlerFunction(); });
  ok(trig.indexOf('tick') >= 0, 'Schedules installed', 'menu 3');
  lines.push('');
  lines.push('Apify month-to-date $' + monthCost_('apify') + ', projected $' + projectedMonthCost_('apify') + ' / budget $' + settingNum_('APIFY_MONTHLY_BUDGET'));
  lines.push('Claude month-to-date $' + monthCost_('claude') + ', projected $' + projectedMonthCost_('claude') + ' / budget $' + settingNum_('CLAUDE_MONTHLY_BUDGET'));
  logEvent_('info', 'check', lines.join(' | '));
  safeAlert_(lines.join('\n'));
  return lines;
}


// ===== Sheets.js =====
/**
 * Sheets.js: sheet access, Deals/Filtered rows, the Seen index, the Queue and pending Apify runs.
 */

var STATUSES = ['New', 'Contacted', 'Picked Up', 'Repairing', 'Listed', 'Sold', 'Passed'];

/** Deals tab columns: [header, key]. The first 18 match the spec order; the rest are detail columns. */
var DEAL_COLS = [
  ['Score', 'opportunity_score'],
  ['Thumbnail', 'thumbnail_formula'],
  ['Title', 'title'],
  ['Source', 'source'],
  ['Free/Paid', 'free_paid'],
  ['Asking Price', 'price'],
  ['Est Resale', 'resale_range'],
  ['Est Profit', 'est_profit'],
  ['Profit/Hr', 'profit_per_hour'],
  ['Difficulty', 'repair_difficulty'],
  ['Pickup Effort', 'pickup_effort'],
  ['Distance', 'distance_miles'],
  ['Category', 'category'],
  ['Reasoning', 'reasoning'],
  ['Listing Link', 'url'],
  ['Photo Folder Link', 'folder_url'],
  ['Status', 'status'],
  ['Date Found', 'date_found'],
  ['Matched Search', 'matched_search'],
  ['Below Market', 'below_market'],
  ['Item Type', 'item_type'],
  ['Brand/Model', 'brand_model_guess'],
  ['Condition', 'condition_guess'],
  ['Likely Fault', 'likely_fault'],
  ['Resale Low', 'est_resale_low'],
  ['Resale High', 'est_resale_high'],
  ['Parts Cost', 'est_parts_cost'],
  ['Repair Hrs', 'est_repair_hours'],
  ['City', 'city'],
  ['Posted', 'posted_at'],
  ['Image URL', 'image_url'],
  ['Draft Listing', 'draft_url'],
  ['Notified', 'notified'],
  ['Deal ID', 'deal_id'],
  ['Data', 'data_json']
];

var FILTERED_COLS = ['Date', 'Source', 'Title', 'Price', 'City', 'Reason', 'Listing Link', 'Deal ID'];
var SALES_COLS = ['Deal ID', 'Title', 'Category', 'Bought Price', 'Parts Cost', 'Hours Spent', 'Sale Price', 'Date Sold', 'Est Profit', 'Actual Profit', 'Notes'];
var LOG_COLS = ['Time', 'Level', 'Job', 'Message', 'Cost USD', 'Details'];
var SEEN_COLS = ['Deal ID', 'First Seen', 'Source'];
var QUEUE_COLS = ['Deal ID', 'Added', 'Stage', 'Item JSON'];
var RUNS_COLS = ['Run ID', 'Kind', 'Started', 'Meta JSON'];

var ss_ = null;

function getSpreadsheet_() {
  if (ss_) return ss_;
  var id = prop_(PROP.SHEET_ID);
  ss_ = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  return ss_;
}

function getSheet_(name) {
  var ss = getSpreadsheet_();
  return ss ? ss.getSheetByName(name) : null;
}

function dealColIndex_(key) {
  for (var i = 0; i < DEAL_COLS.length; i++) if (DEAL_COLS[i][1] === key) return i + 1;
  throw new Error('Unknown deal column ' + key);
}

/** Stable ID used for dedupe across runs: "fb:123", "ksl:82343709", "share:<hash>". */
function dealId_(source, listingId) {
  return String(source).toLowerCase() + ':' + String(listingId);
}

// ---------------------------------------------------------------------------
// Seen index (dedupe)

var seenSet_ = null;

function loadSeen_() {
  if (seenSet_) return seenSet_;
  seenSet_ = {};
  var sh = getSheet_(SHEETS.SEEN);
  if (sh && sh.getLastRow() > 1) {
    sh.getRange(2, 1, sh.getLastRow() - 1, 1).getValues().forEach(function (r) { seenSet_[r[0]] = true; });
  }
  return seenSet_;
}

function isSeen_(id) { return !!loadSeen_()[id]; }

function markSeen_(ids, source) {
  if (!ids.length) return;
  var seen = loadSeen_();
  var now = new Date();
  var rows = [];
  ids.forEach(function (id) {
    if (!seen[id]) { seen[id] = true; rows.push([id, now, source]); }
  });
  if (rows.length) {
    var sh = getSheet_(SHEETS.SEEN);
    sh.getRange(sh.getLastRow() + 1, 1, rows.length, 3).setValues(rows);
  }
}

/** Drop Seen rows older than SEEN_EXPIRY_DAYS (but keep anything still on the Deals tab). */
function expireSeen_() {
  var sh = getSheet_(SHEETS.SEEN);
  if (!sh || sh.getLastRow() < 2) return;
  var cutoff = nowMs_() - settingNum_('SEEN_EXPIRY_DAYS') * 86400000;
  var data = sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues();
  var keep = data.filter(function (r) { return r[1] instanceof Date && r[1].getTime() >= cutoff; });
  if (keep.length === data.length) return;
  sh.getRange(2, 1, data.length, 3).clearContent();
  if (keep.length) sh.getRange(2, 1, keep.length, 3).setValues(keep);
  seenSet_ = null;
  logEvent_('info', 'housekeeping', 'Expired ' + (data.length - keep.length) + ' seen IDs');
}

// ---------------------------------------------------------------------------
// Queue

/**
 * Add normalized items to the Queue if they haven't been seen. Marks them seen immediately so
 * overlapping runs never queue the same listing twice. Returns the number queued.
 */
function enqueueItems_(items, source) {
  var fresh = [];
  var batchIds = {};
  items.forEach(function (it) {
    if (!it || !it.deal_id || batchIds[it.deal_id] || isSeen_(it.deal_id)) return;
    batchIds[it.deal_id] = true;
    fresh.push(it);
  });
  if (!fresh.length) return 0;
  var sh = getSheet_(SHEETS.QUEUE);
  var now = new Date();
  var rows = fresh.map(function (it) { return [it.deal_id, now, 'new', JSON.stringify(it)]; });
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, 4).setValues(rows);
  markSeen_(fresh.map(function (it) { return it.deal_id; }), source);
  return fresh.length;
}

/** Read up to `limit` queue entries (oldest first, free items first). Returns [{row, item, stage}]. */
function readQueue_(limit) {
  var sh = getSheet_(SHEETS.QUEUE);
  if (!sh || sh.getLastRow() < 2) return [];
  var data = sh.getRange(2, 1, sh.getLastRow() - 1, 4).getValues();
  var entries = [];
  data.forEach(function (r, i) {
    if (!r[0]) return;
    try { entries.push({ row: i + 2, stage: r[2], item: JSON.parse(r[3]) }); } catch (e) { entries.push({ row: i + 2, stage: 'bad', item: null }); }
  });
  entries.sort(function (a, b) {
    var fa = a.item && a.item.price === 0 ? 0 : 1, fb = b.item && b.item.price === 0 ? 0 : 1;
    return fa - fb || a.row - b.row;
  });
  return entries.slice(0, limit);
}

function updateQueueEntry_(row, stage, item) {
  getSheet_(SHEETS.QUEUE).getRange(row, 3, 1, 2).setValues([[stage, JSON.stringify(item)]]);
}

/** Delete queue rows (bottom-up so row numbers stay valid). */
function removeQueueRows_(rows) {
  var sh = getSheet_(SHEETS.QUEUE);
  rows.slice().sort(function (a, b) { return b - a; }).forEach(function (r) { sh.deleteRow(r); });
}

function queueLength_() {
  var sh = getSheet_(SHEETS.QUEUE);
  return sh ? Math.max(0, sh.getLastRow() - 1) : 0;
}

// ---------------------------------------------------------------------------
// Deals / Filtered rows

function appendDeal_(item) {
  var sh = getSheet_(SHEETS.DEALS);
  item.thumbnail_formula = item.image_url ? '=IMAGE("' + String(item.image_url).replace(/"/g, '%22') + '")' : '';
  item.resale_range = (item.est_resale_low !== undefined && item.est_resale_high !== undefined)
    ? '$' + Math.round(item.est_resale_low) + '–$' + Math.round(item.est_resale_high) : '';
  item.free_paid = item.price === 0 ? 'Free' : 'Paid';
  item.status = item.status || 'New';
  item.date_found = item.date_found ? new Date(item.date_found) : new Date();
  var slim = JSON.parse(JSON.stringify(item));
  delete slim.thumbnail_formula; delete slim.description_full;
  item.data_json = truncate_(JSON.stringify(slim), 45000);
  var row = DEAL_COLS.map(function (c) {
    var v = item[c[1]];
    if (v === undefined || v === null) return '';
    if (typeof v === 'boolean') return v ? 'Yes' : 'No';
    return v;
  });
  sh.appendRow(row);
  return sh.getLastRow();
}

function appendFiltered_(item, reason) {
  var sh = getSheet_(SHEETS.FILTERED);
  sh.appendRow([new Date(), item.source || '', item.title || '', item.price === null || item.price === undefined ? '' : item.price,
    item.city || '', reason, item.url || '', item.deal_id || '']);
}

/** Find a deal row by Deal ID. Returns {row, values} or null. */
function findDealRow_(dealId) {
  var sh = getSheet_(SHEETS.DEALS);
  if (sh.getLastRow() < 2) return null;
  var col = dealColIndex_('deal_id');
  var ids = sh.getRange(2, col, sh.getLastRow() - 1, 1).getValues();
  for (var i = ids.length - 1; i >= 0; i--) {
    if (ids[i][0] === dealId) {
      return { row: i + 2, values: sh.getRange(i + 2, 1, 1, DEAL_COLS.length).getValues()[0] };
    }
  }
  return null;
}

/** Row values -> object keyed by DEAL_COLS keys, merged with the Data JSON. */
function dealRowToObject_(values) {
  var o = {};
  try { o = JSON.parse(values[dealColIndex_('data_json') - 1] || '{}'); } catch (e) { o = {}; }
  DEAL_COLS.forEach(function (c, i) {
    if (c[1] === 'data_json' || c[1] === 'thumbnail_formula') return;
    var v = values[i];
    if (v instanceof Date) v = v.toISOString();
    if (v !== '' && v !== null && v !== undefined) o[c[1]] = v;
  });
  return o;
}

function setDealField_(row, key, value) {
  getSheet_(SHEETS.DEALS).getRange(row, dealColIndex_(key)).setValue(value);
}

// ---------------------------------------------------------------------------
// Pending Apify runs

function addPendingRun_(runId, kind, meta) {
  getSheet_(SHEETS.RUNS).appendRow([runId, kind, new Date(), JSON.stringify(meta || {})]);
}

function listPendingRuns_() {
  var sh = getSheet_(SHEETS.RUNS);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 4).getValues().map(function (r, i) {
    var meta = {};
    try { meta = JSON.parse(r[3] || '{}'); } catch (e) { /* ignore */ }
    return { row: i + 2, runId: r[0], kind: r[1], started: r[2], meta: meta };
  }).filter(function (r) { return r.runId; });
}

function removePendingRun_(row) { getSheet_(SHEETS.RUNS).deleteRow(row); }


// ===== Util.js =====
/**
 * Util.js: time, distance, geocoding, HTTP and logging helpers.
 */

var TZ = 'America/Denver';

function nowMs_() { return Date.now(); }

/** Hour/minute in the script time zone. */
function localParts_(date) {
  var d = date || new Date();
  var s = Utilities.formatDate(d, TZ, 'yyyy-MM-dd HH mm');
  var p = s.split(' ');
  return { day: p[0], hour: Number(p[1]), minute: Number(p[2]) };
}

function todayKey_() { return localParts_().day; }

function monthKey_(date) { return Utilities.formatDate(date || new Date(), TZ, 'yyyy-MM'); }

function fmtTime_(date) { return Utilities.formatDate(date || new Date(), TZ, 'yyyy-MM-dd HH:mm'); }

/** True when `hour` is in [start, end) handling ranges that wrap midnight. */
function hourInRange_(hour, start, end) {
  if (start === end) return true;
  if (start < end) return hour >= start && hour < end;
  return hour >= start || hour < end;
}

function isQuietHours_() {
  var h = localParts_().hour;
  return hourInRange_(h, settingNum_('QUIET_START'), settingNum_('QUIET_END'));
}

/**
 * Which "HH:MM" times from `times` are due now and not yet done today.
 * `doneKeyPrefix` is stored in Script Properties per time so each slot fires once per day.
 * A slot counts as due from its time until 3 hours later (missed ticks catch up).
 */
function dueSlots_(times, doneKeyPrefix) {
  var p = localParts_();
  var nowMin = p.hour * 60 + p.minute;
  var props = PropertiesService.getScriptProperties();
  var due = [];
  times.forEach(function (t) {
    var m = /^(\d{1,2}):(\d{2})$/.exec(t);
    if (!m) return;
    var slotMin = Number(m[1]) * 60 + Number(m[2]);
    if (nowMin < slotMin || nowMin > slotMin + 180) return;
    var key = doneKeyPrefix + t;
    if (props.getProperty(key) === p.day) return;
    due.push({ time: t, markDone: function () { props.setProperty(key, p.day); } });
  });
  return due;
}

/** True if at least `minutes` have passed since the timestamp stored under `key`; does NOT update. */
function intervalDue_(key, minutes) {
  var last = Number(prop_(key) || 0);
  return nowMs_() - last >= minutes * 60 * 1000 - 30 * 1000; // 30s slack for trigger jitter
}

function markInterval_(key) { setProp_(key, nowMs_()); }

// ---------------------------------------------------------------------------
// Distance & geocoding

function haversineMiles_(lat1, lng1, lat2, lng2) {
  var R = 3958.8;
  var toRad = function (x) { return x * Math.PI / 180; };
  var dLat = toRad(lat2 - lat1), dLng = toRad(lng2 - lng1);
  var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
  return 2 * R * Math.asin(Math.sqrt(a));
}

/** Geocode a free-text place ("Bluffdale, UT" or "84065"). Cached for 30 days in CacheService + properties. */
function geocode_(query) {
  if (!query) return null;
  var key = 'geo:' + String(query).toLowerCase().replace(/\s+/g, ' ').trim();
  var cache = CacheService.getScriptCache();
  var hit = cache.get(key);
  if (hit) return hit === 'null' ? null : JSON.parse(hit);
  var docProps = PropertiesService.getDocumentProperties() || PropertiesService.getScriptProperties();
  var stored = docProps.getProperty(key);
  if (stored) { cache.put(key, stored, 21600); return stored === 'null' ? null : JSON.parse(stored); }
  var result = null;
  try {
    var resp = Maps.newGeocoder().setRegion('us').geocode(query);
    if (resp && resp.status === 'OK' && resp.results && resp.results.length) {
      var loc = resp.results[0].geometry.location;
      result = { lat: loc.lat, lng: loc.lng };
    }
  } catch (e) {
    logEvent_('warn', 'geocode', 'Geocode failed for ' + query + ': ' + e.message);
    return null; // don't cache failures caused by quota
  }
  var json = result ? JSON.stringify(result) : 'null';
  cache.put(key, json, 21600);
  try { docProps.setProperty(key, json); } catch (e) { /* property store full: cache only */ }
  return result;
}

function homeLatLng_() {
  var lat = Number(prop_(PROP.HOME_LAT)), lng = Number(prop_(PROP.HOME_LNG));
  if (lat && lng) return { lat: lat, lng: lng };
  var g = geocode_(settingStr_('HOME_ZIP') + ', USA');
  if (g) { setProp_(PROP.HOME_LAT, g.lat); setProp_(PROP.HOME_LNG, g.lng); }
  return g;
}

/** Distance in miles from home for an item with lat/lng or a place string. null if unknown. */
function distanceFromHome_(item) {
  var home = homeLatLng_();
  if (!home) return null;
  var lat = item.lat, lng = item.lng;
  if (!(lat && lng)) {
    var q = item.zip ? item.zip + ', USA' : (item.city ? item.city + (item.state ? ', ' + item.state : ', UT') : '');
    var g = geocode_(q);
    if (!g) return null;
    lat = g.lat; lng = g.lng;
    item.lat = lat; item.lng = lng;
  }
  return Math.round(haversineMiles_(home.lat, home.lng, lat, lng) * 10) / 10;
}

// ---------------------------------------------------------------------------
// HTTP

/**
 * UrlFetchApp wrapper: returns {code, text, json, headers}. Retries 429/5xx up to `retries` times.
 */
function http_(url, options, retries) {
  options = options || {};
  options.muteHttpExceptions = true;
  retries = retries === undefined ? 2 : retries;
  var attempt = 0, resp, code;
  while (true) {
    resp = UrlFetchApp.fetch(url, options);
    code = resp.getResponseCode();
    if ((code === 429 || code >= 500) && attempt < retries) {
      attempt++;
      Utilities.sleep(1500 * Math.pow(2, attempt));
      continue;
    }
    break;
  }
  var text = resp.getContentText();
  var json = null;
  try { json = JSON.parse(text); } catch (e) { /* not json */ }
  return { code: code, text: text, json: json, headers: resp.getAllHeaders() };
}

// ---------------------------------------------------------------------------
// Logging (Logs tab)

/**
 * Append to the Logs tab. level: info|warn|error|cost. `cost` (USD) and `source` feed budget tracking.
 */
function logEvent_(level, job, message, cost, extra) {
  try {
    var sh = getSheet_(SHEETS.LOGS);
    if (!sh) { console.log(level, job, message); return; }
    sh.appendRow([new Date(), level, job, String(message).slice(0, 2000), cost || '', extra ? JSON.stringify(extra).slice(0, 2000) : '']);
  } catch (e) {
    console.log('logEvent_ failed', e, level, job, message);
  }
  if (level === 'error') console.error(job + ': ' + message); else console.log(job + ': ' + message);
}

/** Sum costs in Logs for this month where job starts with `prefix` (e.g. 'apify', 'claude'). */
var monthCostMemo_ = {};

function monthCost_(prefix) {
  var memo = monthCostMemo_[prefix];
  if (memo && nowMs_() - memo.at < 60000) return memo.value;
  var value = monthCostUncached_(prefix);
  monthCostMemo_[prefix] = { at: nowMs_(), value: value };
  return value;
}

function monthCostUncached_(prefix) {
  var sh = getSheet_(SHEETS.LOGS);
  if (!sh || sh.getLastRow() < 2) return 0;
  var rows = sh.getRange(2, 1, sh.getLastRow() - 1, 5).getValues();
  var mk = monthKey_();
  var total = 0;
  for (var i = rows.length - 1; i >= 0; i--) {
    var d = rows[i][0];
    if (!(d instanceof Date)) continue;
    var k = monthKey_(d);
    if (k < mk) break; // logs are chronological
    if (k === mk && String(rows[i][2]).indexOf(prefix) === 0 && rows[i][4] !== '') total += Number(rows[i][4]) || 0;
  }
  return Math.round(total * 10000) / 10000;
}

/** Projected full-month cost from month-to-date pace. */
function projectedMonthCost_(prefix) {
  var mtd = monthCost_(prefix);
  var now = new Date();
  var day = Number(Utilities.formatDate(now, TZ, 'd'));
  var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
  var hourFrac = localParts_().hour / 24;
  var elapsed = Math.max(0.25, day - 1 + hourFrac);
  return Math.round(mtd / elapsed * daysInMonth * 100) / 100;
}

/** Daily counter stored in Script Properties: key resets each day. */
function dailyCount_(name) {
  var raw = prop_('count:' + name);
  if (!raw) return 0;
  var p = raw.split('|');
  return p[0] === todayKey_() ? Number(p[1]) : 0;
}

function bumpDaily_(name, by) {
  var n = dailyCount_(name) + (by || 1);
  setProp_('count:' + name, todayKey_() + '|' + n);
  return n;
}

function truncate_(s, n) {
  s = String(s || '');
  return s.length > n ? s.slice(0, n - 1) + '…' : s;
}

function randInt_(min, max) { return Math.floor(min + Math.random() * (max - min + 1)); }


// ===== WebApp.js =====
/**
 * WebApp.js: doGet (mobile dashboard) and doPost (iPhone Shortcut share endpoint).
 *
 * The web app is deployed "Execute as: Me, Who has access: Anyone" so the iPhone Shortcut can post to it;
 * every request is therefore checked against a secret: DASHBOARD_KEY for the dashboard, SHARE_TOKEN for shares.
 */

function doGet(e) {
  var p = (e && e.parameter) || {};
  if (!p.k || p.k !== prop_(PROP.DASHBOARD_KEY)) {
    return HtmlService.createHtmlOutput('<p style="font:16px sans-serif;padding:2em">Not authorized. Open the dashboard link from Deal Finder → Show dashboard link.</p>');
  }
  var url = ScriptApp.getService().getUrl();
  if (url && url !== prop_(PROP.WEBAPP_URL)) setProp_(PROP.WEBAPP_URL, url);
  var t = HtmlService.createTemplateFromFile('Dashboard');
  t.key = p.k;
  t.focusId = p.id || '';
  return t.evaluate()
    .setTitle('Deal Finder')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);
}

function showDashboardLink() {
  var url = dashboardUrl_();
  safeAlert_(url ? 'Dashboard (bookmark this on your phone; it contains your private key):\n\n' + url
    : 'Not deployed yet. Deploy → New deployment → Web app (Execute as: Me, Access: Anyone), then open the deployment URL once with ?k=' + prop_(PROP.DASHBOARD_KEY));
}

function checkKey_(key) {
  if (!key || key !== prop_(PROP.DASHBOARD_KEY)) throw new Error('Not authorized');
}

// ---------------------------------------------------------------------------
// Dashboard server functions (called with google.script.run)

/** Recent deals as plain objects for the card grid (newest 600 rows). */
function dashGetDeals(key) {
  checkKey_(key);
  var sh = getSheet_(SHEETS.DEALS);
  var last = sh.getLastRow();
  if (last < 2) return { deals: [], statuses: STATUSES };
  var start = Math.max(2, last - 599);
  var values = sh.getRange(start, 1, last - start + 1, DEAL_COLS.length).getValues();
  var deals = values.map(function (v) {
    var o = dealRowToObject_(v);
    return {
      id: o.deal_id, score: o.opportunity_score, title: o.title, source: o.source, free: o.price === 0, price: o.price,
      profit: o.est_profit, pph: o.profit_per_hour, low: o.est_resale_low, high: o.est_resale_high, dist: o.distance_miles,
      tier: o.distance_tier, category: o.category, reasoning: o.reasoning, url: o.url, image: o.image_url, status: o.status || 'New',
      found: o.date_found, posted: o.posted_at, city: o.city, difficulty: o.repair_difficulty, pickup: o.pickup_effort,
      fault: o.likely_fault, model: o.brand_model_guess, folder: o.folder_url, draft: o.draft_url, search: o.matched_search,
      below: o.below_market === 'Yes' || o.below_market === true
    };
  }).filter(function (d) { return d.id; });
  return { deals: deals, statuses: STATUSES };
}

function dashSetStatus(key, dealId, status) {
  checkKey_(key);
  if (STATUSES.indexOf(status) < 0) throw new Error('Bad status');
  var f = findDealRow_(dealId);
  if (!f) throw new Error('Deal not found');
  setDealField_(f.row, 'status', status);
  var folderUrl = '';
  if (['Picked Up', 'Repairing', 'Listed'].indexOf(status) >= 0) folderUrl = ensureDealFolder_(f.row).getUrl();
  return { ok: true, folder: folderUrl };
}

function dashDraftListing(key, dealId, notes) {
  checkKey_(key);
  return draftListingFor_(dealId, notes);
}

/** Record a sale in the Sales log and mark the deal Sold. */
function dashLogSale(key, dealId, salePrice, hours, partsCost) {
  checkKey_(key);
  var f = findDealRow_(dealId);
  if (!f) throw new Error('Deal not found');
  var d = dealRowToObject_(f.values);
  var sales = getSheet_(SHEETS.SALES);
  var row = sales.getLastRow() + 1;
  sales.getRange(row, 1, 1, 9).setValues([[dealId, d.title, d.category || '', Number(d.price) || 0, Number(partsCost) || 0, Number(hours) || 0,
    Number(salePrice) || 0, new Date(), Number(d.est_profit) || 0]]);
  setDealField_(f.row, 'status', 'Sold');
  CacheService.getScriptCache().remove('calibNotes');
  return { ok: true, profit: (Number(salePrice) || 0) - (Number(d.price) || 0) - (Number(partsCost) || 0) };
}

/** Create (once) the per-deal photo folder and store its link on the row. Returns the Folder. */
function ensureDealFolder_(row) {
  var sh = getSheet_(SHEETS.DEALS);
  var existing = sh.getRange(row, dealColIndex_('folder_url')).getValue();
  var m = /folders\/([\w-]+)/.exec(String(existing));
  if (m) { try { return DriveApp.getFolderById(m[1]); } catch (e) { /* recreate */ } }
  var title = sh.getRange(row, dealColIndex_('title')).getValue();
  var id = sh.getRange(row, dealColIndex_('deal_id')).getValue();
  var folder = DriveApp.getFolderById(requireProp_(PROP.DRIVE_FOLDER_ID)).createFolder(truncate_(title, 60) + ' [' + id + ']');
  sh.getRange(row, dealColIndex_('folder_url')).setValue(folder.getUrl());
  return folder;
}

// ---------------------------------------------------------------------------
// Manual share endpoint (iPhone Shortcut)

/**
 * POST JSON: {"token": SHARE_TOKEN, "url": "...", "text": "...", "image": "<base64>", "imageType": "image/jpeg"}
 * Returns JSON {ok, title, score, profit, dashboard}.
 */
function doPost(e) {
  var out;
  try {
    var body = {};
    if (e.postData && e.postData.contents) {
      try { body = JSON.parse(e.postData.contents); } catch (err) { body = {}; }
    }
    var p = e.parameter || {};
    var token = body.token || p.token;
    if (!token || token !== prop_(PROP.SHARE_TOKEN)) return jsonOut_({ ok: false, error: 'bad token' });
    out = handleShare_(body.url || p.url || '', body.text || p.text || '', body.image || '', body.imageType || 'image/jpeg');
  } catch (err) {
    logEvent_('error', 'share', err.message);
    out = { ok: false, error: err.message };
  }
  return jsonOut_(out);
}

function jsonOut_(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}

function handleShare_(url, text, imageB64, imageType) {
  // No script lock here: a 5-minute tick can hold it for minutes and the Shortcut would time out.
  resetConfigCache_();
  var m = /https?:\/\/\S+/.exec(text || '');
  if (!url && m) url = m[0];
  var blob = imageB64 ? Utilities.newBlob(Utilities.base64Decode(String(imageB64).replace(/^data:[^,]+,/, '')), imageType, 'share') : null;
  var x = aiExtractShare_(text, url, blob);
  var fbId = /facebook\.com\/marketplace\/item\/(\d+)/.exec(url || '');
  var kslId = kslListingIdFromUrl_(url || '');
  var dealId = fbId ? dealId_('fb', fbId[1]) : kslId ? dealId_('ksl', kslId)
    : dealId_('share', Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, (url || '') + x.title)).slice(0, 12));
  var existing = findDealRow_(dealId);
  if (existing) {
    var d = dealRowToObject_(existing.values);
    return { ok: true, duplicate: true, title: d.title, score: d.opportunity_score, profit: d.est_profit, dashboard: dashboardUrl_(dealId) };
  }
  var item = {
    deal_id: dealId, source: 'Share', listing_id: dealId.split(':')[1], title: x.title, price: x.price < 0 ? null : x.price,
    city: x.city, state: x.state, url: url, image_url: '', image_urls: [], description: x.description,
    matched_search: 'Manual share (' + (x.source || 'Other') + ')', posted_at: ''
  };
  if (blob) {
    var folder = DriveApp.getFolderById(requireProp_(PROP.DRIVE_FOLDER_ID));
    var sub = folder.getFoldersByName('Shared screenshots');
    var shotFolder = sub.hasNext() ? sub.next() : folder.createFolder('Shared screenshots');
    var file = shotFolder.createFile(blob.setName(dealId.replace(':', '-') + '.jpg'));
    try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (err) { /* thumbnail then only shows when signed in */ }
    item.image_url = 'https://drive.google.com/thumbnail?id=' + file.getId() + '&sz=w600';
  }
  item.distance_miles = distanceFromHome_(item);
  markSeen_([dealId], 'Share');
  item.quick_resale_guess = 0;
  valuateAndRecord_(item);
  return { ok: true, title: item.title, score: item.opportunity_score, profit: item.est_profit, reasoning: item.reasoning, dashboard: dashboardUrl_(dealId) };
}
