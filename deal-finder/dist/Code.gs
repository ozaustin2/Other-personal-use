// ---------------------------------------------------------------------------
// Script Properties

function prop_(key) {
  return PropertiesService.getScriptProperties().getProperty(key) || '';
}

function setProp_(key, value) {
  PropertiesService.getScriptProperties().setProperty(key, String(value));
}

function requireProp_(key) {
  var v = prop_(key);
  if (!v) throw new Error('Missing Script Property ' + key + '. See SETUP_CHECKLIST.md.');
  return v;
}

// ---------------------------------------------------------------------------
// Settings tab

var settingsCache_ = null;

/** Returns the whole parsed Settings tab: {kv, keywords, fbCategories, kslSearches, weights}. */
function getConfig_() {
  if (settingsCache_) return settingsCache_;
  var sh = getSheet_(SHEETS.SETTINGS);
  var values = sh ? sh.getDataRange().getValues() : [];
  settingsCache_ = parseSettingsValues_(values);
  return settingsCache_;
}

function resetConfigCache_() {
  settingsCache_ = null;
}

/** Pure parser so it can be unit-tested outside Apps Script. */
function parseSettingsValues_(values) {
  var cfg = { kv: {}, keywords: [], fbCategories: [], kslSearches: [], weights: {} };
  DEFAULT_SETTINGS.forEach(function (r) { cfg.kv[r[0]] = r[1]; });
  var section = null;
  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var first = String(row[0] === undefined ? '' : row[0]).trim();
    if (first.indexOf('## ') === 0) { section = first; continue; }
    if (!first || first.charAt(0) === '#') continue;
    if (row[0] === 'Key' || row[0] === 'Keyword' || row[0] === 'Name' || row[0] === 'Category') continue; // headers
    if (section === SECTION.SETTINGS) {
      cfg.kv[first] = row[1];
    } else if (section === SECTION.KEYWORDS) {
      cfg.keywords.push({ keyword: first, radius: num_(row[1], 25), maxPrice: blankToNull_(row[2]), enabled: bool_(row[3], true) });
    } else if (section === SECTION.FB_CATEGORIES) {
      cfg.fbCategories.push({ name: first, slug: String(row[1]).trim(), maxPrice: blankToNull_(row[2]), enabled: bool_(row[3], true) });
    } else if (section === SECTION.KSL_SEARCHES) {
      cfg.kslSearches.push({
        name: first, type: String(row[1]).trim(), category: String(row[2] || '').trim(), subcategory: String(row[3] || '').trim(),
        keyword: String(row[4] || '').trim(), radius: num_(row[5], 25), maxPrice: blankToNull_(row[6]), baselinePages: num_(row[7], 3)
      });
    } else if (section === SECTION.WEIGHTS) {
      cfg.weights[first.toLowerCase()] = num_(row[1], 1);
    }
  }
  if (!values.length) {
    cfg.keywords = DEFAULT_KEYWORDS.map(function (r) { return { keyword: r[0], radius: r[1], maxPrice: blankToNull_(r[2]), enabled: r[3] }; });
    cfg.fbCategories = DEFAULT_FB_CATEGORIES.map(function (r) { return { name: r[0], slug: r[1], maxPrice: r[2], enabled: r[3] }; });
    cfg.kslSearches = DEFAULT_KSL_SEARCHES.map(function (r) {
      return { name: r[0], type: r[1], category: r[2], subcategory: r[3], keyword: r[4], radius: r[5], maxPrice: blankToNull_(r[6]), baselinePages: r[7] };
    });
    DEFAULT_WEIGHTS.forEach(function (r) { cfg.weights[r[0]] = r[1]; });
  }
  return cfg;
}

/** Typed getters for key/value settings. */
function setting_(key) {
  var cfg = getConfig_();
  return cfg.kv.hasOwnProperty(key) ? cfg.kv[key] : null;
}
function settingNum_(key) { return num_(setting_(key), 0); }
function settingBool_(key) { return bool_(setting_(key), false); }
function settingStr_(key) { var v = setting_(key); return v === null || v === undefined ? '' : String(v).trim(); }
function settingTimes_(key) {
  return settingStr_(key).split(',').map(function (s) { return s.trim(); }).filter(Boolean);
}

/** Write a single key/value setting back to the Settings tab (used for machine-set values). */
function writeSetting_(key, value) {
  var sh = getSheet_(SHEETS.SETTINGS);
  var values = sh.getDataRange().getValues();
  var inSettings = false;
  for (var i = 0; i < values.length; i++) {
    var first = String(values[i][0]).trim();
    if (first.indexOf('## ') === 0) { inSettings = first === SECTION.SETTINGS; continue; }
    if (inSettings && first === key) {
      sh.getRange(i + 1, 2).setValue(value);
      if (settingsCache_) settingsCache_.kv[key] = value;
      return;
    }
  }
  throw new Error('Setting not found: ' + key);
}

// ---------------------------------------------------------------------------
// small coercion helpers

function num_(v, dflt) {
  if (v === '' || v === null || v === undefined) return dflt;
  var n = Number(String(v).replace(/[$,]/g, ''));
  return isNaN(n) ? dflt : n;
}

function bool_(v, dflt) {
  if (v === true || v === false) return v;
  var s = String(v === undefined || v === null ? '' : v).trim().toLowerCase();
  if (s === 'true' || s === 'yes' || s === 'y' || s === '1' || s === 'on') return true;
  if (s === 'false' || s === 'no' || s === 'n' || s === '0' || s === 'off') return false;
  return dflt;
}

function blankToNull_(v) {
  if (v === '' || v === null || v === undefined) return null;
  var s = String(v).trim().toLowerCase();
  if (s === 'no max' || s === 'none' || s === '-') return null;
  return num_(v, null);
}


// ===== Ebay.js =====
/**
 * Ebay.js: price comps from eBay Browse API active listings (client-credentials OAuth).
 */

function ebayToken_() {
  var cache = CacheService.getScriptCache();
  var t = cache.get('ebayToken');
  if (t) return t;
  var appId = prop_(PROP.EBAY_APP_ID), cert = prop_(PROP.EBAY_CERT_ID);
  if (!appId || !cert) return null;
  var resp = http_('https://api.ebay.com/identity/v1/oauth2/token', {
    method: 'post',
    headers: { Authorization: 'Basic ' + Utilities.base64Encode(appId + ':' + cert) },
    contentType: 'application/x-www-form-urlencoded',
    payload: 'grant_type=client_credentials&scope=' + encodeURIComponent('https://api.ebay.com/oauth/api_scope')
  }, 1);
  if (resp.code !== 200 || !resp.json) {
    logEvent_('error', 'ebay', 'Token failed HTTP ' + resp.code + ': ' + truncate_(resp.text, 200));
    return null;
  }
  t = resp.json.access_token;
  cache.put('ebayToken', t, Math.min(21600, (resp.json.expires_in || 7200) - 300));
  return t;
}

/** Turn a listing title into a search query: drop filler words that hurt matching. */
function ebayQuery_(title) {
  return String(title || '')
    .replace(/\b(free|curb|alert|obo|firm|must go|asap|pickup|pick up|today|only|great|deal|works?|working|not working|for parts|needs? repair|broken|used|like new)\b/gi, ' ')
    .replace(/[^\w\s\-\/.]/g, ' ')
    .replace(/\s+/g, ' ').trim().split(' ').slice(0, 8).join(' ');
}

/**
 * Comps for a title. Returns {query, count, median_local, low_local, high_local, examples:[{title, price}]} or null.
 * Prices are multiplied by EBAY_DISCOUNT to approximate a local sale price.
 */
function ebayComps_(title) {
  if (!settingBool_('EBAY_ENABLED')) return null;
  var q = ebayQuery_(title);
  if (q.length < 3) return null;
  var cacheKey = 'ebay:' + q.toLowerCase();
  var cache = CacheService.getScriptCache();
  var hit = cache.get(cacheKey);
  if (hit) return JSON.parse(hit);
  var token = ebayToken_();
  if (!token) return null;
  var url = 'https://api.ebay.com/buy/browse/v1/item_summary/search?limit=25&q=' + encodeURIComponent(q) +
    '&filter=' + encodeURIComponent('buyingOptions:{FIXED_PRICE},itemLocationCountry:US,priceCurrency:USD');
  var resp = http_(url, { headers: { Authorization: 'Bearer ' + token, 'X-EBAY-C-MARKETPLACE-ID': 'EBAY_US' } }, 1);
  if (resp.code !== 200 || !resp.json) {
    logEvent_('warn', 'ebay', 'Search failed HTTP ' + resp.code + ' for "' + q + '"');
    return null;
  }
  var items = (resp.json.itemSummaries || []).filter(function (s) { return s.price && s.price.value; });
  if (!items.length) { cache.put(cacheKey, 'null', 21600); return null; }
  var disc = settingNum_('EBAY_DISCOUNT') || 0.75;
  var prices = items.map(function (s) { return Number(s.price.value); }).sort(function (a, b) { return a - b; });
  var pct = function (p) { return prices[Math.min(prices.length - 1, Math.floor(p * prices.length))]; };
  var out = {
    query: q,
    count: prices.length,
    median_local: Math.round(pct(0.5) * disc),
    low_local: Math.round(pct(0.2) * disc),
    high_local: Math.round(pct(0.8) * disc),
    examples: items.slice(0, 6).map(function (s) { return { title: truncate_(s.title, 80), price: Number(s.price.value), condition: s.condition || '' }; })
  };
  cache.put(cacheKey, JSON.stringify(out), 21600);
  return out;
}


// ===== Facebook.js =====
/**
 * Facebook.js: Facebook Marketplace via the Apify actor (default apify~facebook-marketplace-scraper).
 * Actor input: {startUrls: [{url}], resultsLimit, includeListingDetails}. Billed per listing returned,
 * so every run is capped with resultsLimit + maxItems + maxTotalChargeUsd.
 */

var FB_PRICE_PER_LISTING = 0.0062; // worst-case (free Apify plan) price, used for charge caps and projections

/** Fill a URL template. A null max price removes the maxPrice parameter entirely ("no max"). */
function fbUrl_(template, vals) {
  var url = template
    .replace('{city}', encodeURIComponent(settingStr_('FB_LOCATION_SLUG')))
    .replace('{km}', String(Math.round((vals.miles || 50) * 1.609)))
    .replace('{slug}', encodeURIComponent(vals.slug || ''))
    .replace('{q}', encodeURIComponent(vals.q || '').replace(/%20/g, '+'));
  if (vals.max === null || vals.max === undefined || vals.max === '') {
    url = url.replace(/([?&])maxPrice=\{max\}&?/, '$1').replace(/[?&]$/, '');
  } else {
    url = url.replace('{max}', String(Math.round(vals.max)));
  }
  return url;
}

function startFacebookRun_(kind, url, limit, meta) {
  var input = { startUrls: [{ url: url }], resultsLimit: limit, includeListingDetails: false };
  var run = apifyStartRun_(settingStr_('FB_ACTOR_ID'), input, {
    maxItems: limit, maxChargeUsd: limit * FB_PRICE_PER_LISTING + 0.02, timeoutSecs: 900
  });
  meta = meta || {};
  meta.url = url;
  addPendingRun_(run.id, kind, meta);
  logEvent_('info', 'fb', 'Started ' + kind + ' run ' + run.id + ' (' + limit + ' max) ' + url);
  return run.id;
}

/** Free sweep: newest free items within FB_FREE_RADIUS_MI. */
function facebookFreeSweep_() {
  if (!settingBool_('FB_ENABLED')) return;
  if (apifyBudgetState_() === 'over') return;
  var url = fbUrl_(settingStr_('FB_URL_FREE'), { miles: settingNum_('FB_FREE_RADIUS_MI') });
  startFacebookRun_('fb-free', url, settingNum_('FB_FREE_RESULTS') || 8, { search: 'FB - Free', free: true });
}

/** Paid sweep: category ceilings + keyword table. One run per URL so each gets its own result cap. */
function facebookPaidSweep_() {
  if (!settingBool_('FB_ENABLED')) return;
  var state = apifyBudgetState_();
  if (state !== 'ok') {
    logEvent_('warn', 'fb', 'Paid sweep skipped: Apify spend ' + (state === 'over' ? 'is over budget' : 'is on pace to exceed budget') +
      ' (projected $' + projectedMonthCost_('apify') + ' vs $' + settingNum_('APIFY_MONTHLY_BUDGET') + ').');
    return;
  }
  var cfg = getConfig_();
  var started = 0;
  cfg.fbCategories.filter(function (c) { return c.enabled; }).forEach(function (c) {
    var url = fbUrl_(settingStr_('FB_URL_CATEGORY'), { slug: c.slug, max: c.maxPrice, miles: settingNum_('FB_CATEGORY_RADIUS_MI') });
    try { startFacebookRun_('fb-paid', url, settingNum_('FB_PAID_RESULTS') || 5, { search: 'FB - ' + c.name, maxPrice: c.maxPrice }); started++; }
    catch (e) { logEvent_('error', 'fb', e.message); }
  });
  cfg.keywords.filter(function (k) { return k.enabled; }).forEach(function (k) {
    var url = fbUrl_(settingStr_('FB_URL_SEARCH'), { q: k.keyword, max: k.maxPrice, miles: k.radius });
    var limit = k.maxPrice === null ? (settingNum_('FB_NOMAX_RESULTS') || 10) : (settingNum_('FB_PAID_RESULTS') || 5);
    try { startFacebookRun_('fb-paid', url, limit, { search: 'FB - ' + k.keyword, maxPrice: k.maxPrice, radius: k.radius }); started++; }
    catch (e) { logEvent_('error', 'fb', e.message); }
  });
  logEvent_('info', 'fb', 'Paid sweep started ' + started + ' runs');
}

/** Normalize one dataset item from the actor. Returns null for sold/hidden/error items. */
function normalizeFacebookItem_(d, meta) {
  if (!d || d.error || !d.id) return null;
  if (d.is_sold || d.isSold || d.is_hidden || d.isHidden || d.is_pending || d.isPending) return null;
  var priceObj = d.listing_price || d.listingPrice || {};
  var amountRaw = priceObj.amount !== undefined ? priceObj.amount : null;
  var formatted = String(priceObj.formatted_amount || '');
  var price = /free/i.test(formatted) ? 0 : (amountRaw !== null && amountRaw !== '' ? Number(amountRaw) : null);
  if (meta && meta.free && (price === null || isNaN(price))) price = 0;
  var geo = (d.location && (d.location.reverse_geocode || d.location)) || {};
  var photo = d.primary_listing_photo || d.primaryListingPhoto || {};
  var img = (photo.image && photo.image.uri) || photo.photo_image_url || '';
  var photos = (d.listingPhotos || []).map(function (p) { return (p.image && p.image.uri) || p.photo_image_url; }).filter(Boolean);
  var title = d.marketplace_listing_title || d.listingTitle || d.custom_title || d.customTitle || '';
  return {
    deal_id: dealId_('fb', d.id),
    source: 'Facebook',
    listing_id: String(d.id),
    title: title,
    price: price,
    city: geo.city || '',
    state: geo.state || '',
    lat: d.location && d.location.latitude ? Number(d.location.latitude) : null,
    lng: d.location && d.location.longitude ? Number(d.location.longitude) : null,
    url: d.listingUrl || d.itemUrl || ('https://www.facebook.com/marketplace/item/' + d.id + '/'),
    image_url: img || photos[0] || '',
    image_urls: photos.length ? photos.slice(0, 4) : (img ? [img] : []),
    description: (d.description && d.description.text) || '',
    condition: d.condition || '',
    posted_at: d.timestamp || '',
    seller_name: (d.marketplace_listing_seller && d.marketplace_listing_seller.name) || '',
    matched_search: (meta && meta.search) || '',
    category_hint: d.marketplace_listing_category_id || ''
  };
}

/** Handler called by pollApifyRuns_ when a Facebook run finishes. */
function handleFacebookResults_(items, meta, status) {
  var norm = items.map(function (d) { return normalizeFacebookItem_(d, meta); }).filter(Boolean);
  // Respect the search's own price ceiling (Facebook sometimes returns slightly-over items).
  if (meta && meta.maxPrice !== null && meta.maxPrice !== undefined) {
    norm = norm.filter(function (it) { return it.price === null || it.price <= meta.maxPrice; });
  }
  var errors = items.filter(function (d) { return d && d.error; });
  if (errors.length) logEvent_('warn', 'fb', errors.length + ' error items, e.g. ' + truncate_(errors[0].error + ' ' + (errors[0].errorDescription || ''), 200));
  if (status !== 'SUCCEEDED' && !norm.length) logEvent_('warn', 'fb', 'Run ended ' + status + ' with no usable items (' + (meta && meta.url) + ')');
  var n = enqueueItems_(norm, 'Facebook');
  logEvent_('info', 'fb', (meta && meta.search) + ': ' + items.length + ' items, ' + n + ' new');
}


// ===== Filter.js =====
/**
 * Filter.js: free rule-based pre-filter (runs before any AI call) plus the keyword pre-filter
 * that decides whether a KSL listing is worth a detail-page fetch.
 */

/** Obvious drops by title. Conservative: anything ambiguous goes on to the AI filter. */
var DROP_RULES = [
  ['furniture', /\b(couch|sofa|sectional|loveseat|love seat|recliner|futon|ottoman|mattress|box spring|bed ?frame|headboard|bunk ?bed|crib|dresser|nightstand|night stand|armoire|wardrobe|bookshel(f|ves)|bookcase|entertainment center|tv stand|coffee table|end table|dining (table|set|room)|kitchen table|desk chair|office chair|chairs?|stools?|bench|cabinets?|hutch|credenza)\b/i],
  ['clothing', /\b(clothes|clothing|shirts?|pants|jeans|dress(es)?|shoes|boots|jackets?|coats?|hoodie|costume)\b/i],
  ['firewood / landscaping material', /\b(firewood|fire wood|dirt|fill dirt|top ?soil|rocks?|gravel|mulch|sod|bark chips|landscape rock|pavers?)\b/i],
  ['pallets / scrap wood', /\b(pallets?|scrap wood|lumber scraps?|wood scraps?|plywood)\b/i],
  ['baby gear', /\b(stroller|car seat|high ?chair|pack ?n ?play|playpen|baby (gear|clothes|items|swing|bouncer)|diapers?)\b/i],
  ['pets / animals', /\b(puppy|puppies|kittens?|chickens?|hens|rooster|rabbits?|bunny|bunnies|horses?|goats?|hamsters?|guinea pigs?|ducklings?|rehome|rehoming|adoption)\b/i],
  ['restricted', /\b(guns?|rifle|pistol|handgun|shotgun|ammo|ammunition|firearm|ar-?15|suppressor|silencer)\b/i],
  ['vague curb alert', /^\s*(curb ?alert|free stuff|misc(ellaneous)?( items| stuff)?|free!*|stuff|junk)\s*!*\s*$/i]
];

/** Words that make a title worth keeping even if a drop rule matches (e.g. "massage chair", "chair lift motor"). */
var RESCUE_RX = /\b(massage|electric|power|motor|lift|recliner motor|lift chair|gaming chair|generator|compressor|welder|appliance|freezer|fridge|refrigerator|washer|dryer|tv|monitor|computer|laptop|speaker|amp|amplifier|receiver|engine|mower|snow ?blower|tool|drill|saw|e-?bike|scooter|battery|solar|inverter|hvac|furnace|air condition)/i;

/** Returns a drop reason string or '' to keep. */
function ruleFilter_(item) {
  var title = String(item.title || '');
  if (!title.trim()) return 'no title';
  for (var i = 0; i < DROP_RULES.length; i++) {
    if (DROP_RULES[i][1].test(title)) {
      if (DROP_RULES[i][0] !== 'restricted' && RESCUE_RX.test(title)) return '';
      return DROP_RULES[i][0];
    }
  }
  return '';
}

/** Target words that justify spending a KSL detail-page fetch. */
var DETAIL_WORTHY_RX = /\b(freeze dryer|harvest right|generator|snow ?blower|e-?bike|electric bike|scooter|welder|compressor|mower|zero turn|riding|tractor|trimmer|chainsaw|pressure washer|tiller|engine|motor|honda|predator|champion|dewalt|milwaukee|makita|ryobi|ego|craftsman|snap-?on|lincoln|miller|hobart|fridge|refrigerator|freezer|washer|dryer|dishwasher|range|oven|microwave|ice maker|kegerator|wine cooler|tv|television|monitor|projector|receiver|amplifier|amp|speaker|subwoofer|turntable|computer|laptop|pc|gaming|xbox|playstation|ps[345]|nintendo|switch|drone|printer|3d printer|ups|battery|inverter|solar|hvac|furnace|air condition|a\/c|heat pump|oscilloscope|multimeter|test equipment|commercial|industrial|not working|needs repair|for parts|broken)\b/i;

function detailWorthy_(item) {
  return DETAIL_WORTHY_RX.test(String(item.title || '') + ' ' + String(item.matched_search || ''));
}


// ===== KslCollector.js =====
/**
 * KslCollector.js: Apps Script side of the KSL backup collector.
 *  - one-time baseline sweep and backup polling via the Apify actor (ksl-collector/)
 *  - single public listing-page fetches for descriptions/photos (direct, same politeness rules)
 *  - daily page cap, robots.txt, 24-hour back-off on blocks
 */

var KSL_USER_AGENT = 'DealFinder-personal/1.0 (personal low-volume deal alerts; one request at a time)';

function kslBlocked_() {
  var until = settingStr_('KSL_BLOCKED_UNTIL');
  return until && new Date(until).getTime() > nowMs_();
}

function kslRecordBlock_(reason) {
  var until = new Date(nowMs_() + 24 * 3600000);
  writeSetting_('KSL_BLOCKED_UNTIL', until.toISOString());
  alert_('KSL blocked us, backing off 24 h', reason + '. All KSL page requests are paused until ' + fmtTime_(until) +
    '. Email alerts keep working. Nothing will try to get around the block.');
}

function kslPagesLeft_() {
  return settingNum_('KSL_DAILY_PAGE_CAP') - dailyCount_('kslPages');
}

function kslRobotsTxt_() {
  var cache = CacheService.getScriptCache();
  var hit = cache.get('kslRobots');
  if (hit !== null) return hit;
  // Unreadable robots.txt (network error / 5xx / 403 / 429) = treat as disallowed; 404 = no rules.
  var r;
  try { r = UrlFetchApp.fetch(KSL_BASE + '/robots.txt', { muteHttpExceptions: true, headers: { 'User-Agent': KSL_USER_AGENT } }); } catch (e) { return null; }
  var code = r.getResponseCode();
  if (code !== 200 && code !== 404) return null;
  var txt = code === 200 ? r.getContentText() : '';
  cache.put('kslRobots', txt.slice(0, 90000), 21600);
  return txt;
}

/** Sleep so consecutive KSL requests are 3–8 s apart (randomized), across executions. */
function kslPoliteWait_() {
  var minS = settingNum_('KSL_MIN_DELAY_S') || 3, maxS = Math.max(minS, settingNum_('KSL_MAX_DELAY_S') || 8);
  var gap = randInt_(minS * 1000, maxS * 1000);
  var since = nowMs_() - Number(prop_('kslLastRequestAt') || 0);
  if (since < gap) Utilities.sleep(gap - since);
  setProp_('kslLastRequestAt', nowMs_());
}

/**
 * Fetch one public listing page and merge description/photos/coordinates into `it`.
 * Always sets it.detail_fetched so we never retry the same listing.
 */
function enrichFromKslDetail_(it) {
  it.detail_fetched = true;
  if (kslBlocked_()) return;
  if (dailyCount_('kslDetail') >= settingNum_('KSL_DETAIL_DAILY_CAP') || kslPagesLeft_() <= 0) return;
  var path = '/listing/' + it.listing_id;
  var robots = kslRobotsTxt_();
  if (robots === null || !kslRobotsAllows_(robots, KSL_USER_AGENT, path)) {
    logEvent_('warn', 'ksl-detail', (robots === null ? 'robots.txt unavailable' : 'robots.txt disallows ' + path) + ', skipped');
    return;
  }
  kslPoliteWait_();
  var resp = UrlFetchApp.fetch(KSL_BASE + path, { muteHttpExceptions: true, followRedirects: true, headers: { 'User-Agent': KSL_USER_AGENT } });
  bumpDaily_('kslDetail');
  bumpDaily_('kslPages');
  var code = resp.getResponseCode();
  var html = resp.getContentText();
  if (code === 403 || code === 429 || kslLooksBlocked_(html)) { kslRecordBlock_('HTTP ' + code + ' on ' + path); return; }
  if (code === 404 || code === 410) { it.listing_gone = true; return; }
  if (code !== 200) { logEvent_('warn', 'ksl-detail', 'HTTP ' + code + ' for ' + path); return; }
  var d = parseKslDetailHtml_(html);
  if (!d) { logEvent_('warn', 'ksl-detail', 'KSL layout changed? Could not parse ' + path); return; }
  ['description', 'lat', 'lng', 'condition', 'zip', 'state'].forEach(function (k) { if (d[k]) it[k] = d[k]; });
  if (d.image_urls && d.image_urls.length) it.image_urls = d.image_urls;
  if (!it.image_url && d.image_url) it.image_url = d.image_url;
  if (!it.city && d.city) it.city = d.city;
  if ((it.price === null || it.price === undefined) && d.price !== null) it.price = d.price;
  if (!it.title && d.title) it.title = d.title;
  if (d.posted_at) it.posted_at = d.posted_at;
}

// ---------------------------------------------------------------------------
// Actor runs (baseline + backup mode)

function kslActorInput_(searches, opts) {
  return {
    mode: opts.mode || 'search',
    zip: settingStr_('HOME_ZIP'),
    searches: searches.map(function (s) {
      return {
        name: s.name, type: s.type, category: s.category, subcategory: s.subcategory, keyword: s.keyword,
        radius: s.radius, maxPrice: s.maxPrice, maxPages: s.pages, stopAtIds: s.stopAtIds || []
      };
    }),
    maxPageLoads: opts.maxPageLoads,
    maxDetailPages: opts.maxDetailPages || 0,
    sinceDays: opts.sinceDays || 0,
    minDelaySecs: settingNum_('KSL_MIN_DELAY_S') || 3,
    maxDelaySecs: settingNum_('KSL_MAX_DELAY_S') || 8,
    userAgent: KSL_USER_AGENT
  };
}

function startKslActor_(kind, searches, opts) {
  var actor = settingStr_('KSL_ACTOR_ID');
  if (!actor) throw new Error('KSL_ACTOR_ID is empty in Settings. Push the actor (SETUP_CHECKLIST Phase 3) first.');
  if (kslBlocked_()) { logEvent_('warn', 'ksl-actor', 'Skipped ' + kind + ': KSL back-off active until ' + settingStr_('KSL_BLOCKED_UNTIL')); return null; }
  if (apifyBudgetState_() === 'over') return null;
  var needsBrowser = searches.some(function (s) { return s.pages > 1; });
  var run = apifyStartRun_(actor, kslActorInput_(searches, opts), { memoryMb: needsBrowser ? 2048 : 256, timeoutSecs: 3600 });
  addPendingRun_(run.id, kind, { searches: searches.map(function (s) { return s.name; }), baseline: !!opts.baseline });
  logEvent_('info', 'ksl-actor', 'Started ' + kind + ' run ' + run.id + ' for ' + searches.length + ' searches (max ' + opts.maxPageLoads + ' page loads)');
  return run.id;
}

/** Menu item: one-time baseline across all saved searches (spreads over 2 days if the daily cap requires). */
function runKslBaseline() {
  var all = getConfig_().kslSearches.map(function (s) {
    var o = JSON.parse(JSON.stringify(s));
    o.pages = s.baselinePages || 3;
    return o;
  });
  setProp_('kslBaselineRemaining', JSON.stringify(all.map(function (s) { return s.name; })));
  var started = continueKslBaseline_();
  safeAlert_(started ? 'KSL baseline sweep started. Results appear on the Deals tab and dashboard over the next ~30 minutes; you\'ll get a "Baseline results" push when done.'
    : 'Could not start the baseline. Check the Logs tab.');
}

/** Start (or continue tomorrow) the baseline with as many searches as today's page budget allows. */
function continueKslBaseline_() {
  var remaining = JSON.parse(prop_('kslBaselineRemaining') || '[]');
  if (!remaining.length) return null;
  var budget = kslPagesLeft_() - settingNum_('KSL_DETAIL_DAILY_CAP'); // keep room for detail fetches
  var searches = getConfig_().kslSearches.filter(function (s) { return remaining.indexOf(s.name) >= 0; });
  var take = [], used = 0;
  searches.forEach(function (s) {
    var pages = s.baselinePages || 3;
    if (used + pages <= budget) { take.push({ name: s.name, type: s.type, category: s.category, subcategory: s.subcategory, keyword: s.keyword, radius: s.radius, maxPrice: s.maxPrice, pages: pages }); used += pages; }
  });
  if (!take.length) { logEvent_('info', 'ksl-baseline', 'No page budget left today; continuing tomorrow'); return null; }
  setProp_('kslBaselineRemaining', JSON.stringify(remaining.filter(function (n) { return !take.some(function (t) { return t.name === n; }); })));
  return startKslActor_('ksl-baseline', take, {
    maxPageLoads: used, baseline: true, sinceDays: settingNum_('KSL_BASELINE_MAX_AGE_DAYS'), maxDetailPages: 0
  });
}

/** Backup mode polling: Free every N minutes, paid searches at set times; 1 page each, stop at last-seen IDs. */
function kslBackupPoll_(which) {
  var lastIds = JSON.parse(prop_('kslLastIds') || '{}');
  var searches = getConfig_().kslSearches.filter(function (s) {
    var isFree = s.type === 'category' && s.category.toUpperCase() === 'FREE';
    return which === 'free' ? isFree : !isFree;
  }).map(function (s) {
    return { name: s.name, type: s.type, category: s.category, subcategory: s.subcategory, keyword: s.keyword, radius: s.radius, maxPrice: s.maxPrice, pages: 1, stopAtIds: lastIds[s.name] || [] };
  });
  var budget = Math.min(searches.length, kslPagesLeft_() - settingNum_('KSL_DETAIL_DAILY_CAP'));
  if (budget <= 0) { logEvent_('warn', 'ksl-backup', 'Daily KSL page cap reached; skipping ' + which + ' poll'); return; }
  startKslActor_('ksl-backup-' + which, searches.slice(0, budget), { maxPageLoads: budget });
}

/** Handler called by pollApifyRuns_ when a KSL actor run finishes. */
function handleKslCollectorResults_(items, output, meta, status) {
  output = output || {};
  if (output.pageLoads) bumpDaily_('kslPages', output.pageLoads);
  if (output.blocked) kslRecordBlock_(output.blockedReason || 'Blocked during collector run');
  if (output.layoutChanged && output.layoutChanged.length) {
    logEvent_('error', 'ksl-actor', 'KSL layout changed: no listings parsed for ' + output.layoutChanged.join(', '));
    alert_('KSL layout changed', 'The collector loaded pages but found no listings for: ' + output.layoutChanged.join(', ') + '. Update ksl-collector/src/config.js / KslParser.js.');
  }
  if (output.robotsSkipped && output.robotsSkipped.length) logEvent_('warn', 'ksl-actor', 'robots.txt disallowed: ' + output.robotsSkipped.join(', '));
  if (output.newestIds) {
    var lastIds = JSON.parse(prop_('kslLastIds') || '{}');
    Object.keys(output.newestIds).forEach(function (k) { lastIds[k] = output.newestIds[k]; });
    setProp_('kslLastIds', JSON.stringify(lastIds));
  }
  var norm = items.filter(function (d) { return d && d.listing_id; }).map(function (d) {
    d.deal_id = 'ksl:' + d.listing_id;
    if (meta.baseline) { d.source = 'KSL (baseline)'; d.baseline = true; } else { d.source = 'KSL'; }
    return d;
  });
  var n = enqueueItems_(norm, 'KSL');
  logEvent_('info', 'ksl-actor', status + ': ' + items.length + ' listings, ' + n + ' new, ' + (output.pageLoads || 0) + ' page loads');

  if (meta.baseline) {
    var remaining = JSON.parse(prop_('kslBaselineRemaining') || '[]');
    if (!remaining.length) {
      writeSetting_('KSL_BASELINE_DATE', todayKey_());
      setProp_('baselineDigestPending', '1');
      logEvent_('info', 'ksl-baseline', 'Baseline complete; KSL is now email-only');
    }
  }
}


// ===== KslEmail.js =====
/**
 * KslEmail.js: primary KSL source. Reads KSL saved-search alert emails from the Gmail label,
 * parses every listing (KslParser.js), queues them, and watches feed health.
 */

/**
 * Gmail groups alerts with the same subject into one thread, and labels are per thread, so we track
 * processed MESSAGE ids in the Seen index ("gmail:<id>") and use the label only as a visual marker.
 */
function kslEmailIntake_() {
  var label = settingStr_('KSL_EMAIL_LABEL');
  var threads = GmailApp.search('label:"' + label + '" newer_than:3d', 0, 30);
  if (!threads.length) return 0;
  var processedLabel = GmailApp.getUserLabelByName(settingStr_('KSL_PROCESSED_LABEL')) || GmailApp.createLabel(settingStr_('KSL_PROCESSED_LABEL'));
  var queued = 0, newest = Number(prop_('kslLastEmailAt') || 0);
  threads.forEach(function (thread) {
    var touched = false;
    thread.getMessages().forEach(function (msg) {
      var mid = 'gmail:' + msg.getId();
      var when = msg.getDate().getTime();
      if (when > newest) newest = when;
      if (isSeen_(mid)) return;
      var items = parseAlertMessage_(msg);
      if (items === null) { markSeen_([mid], 'gmail'); return; } // not an alert (e.g. KSL account email)
      if (!items.length) {
        reportParserFailure_(msg);
      } else {
        queued += enqueueItems_(items, 'KSL');
      }
      markSeen_([mid], 'gmail');
      touched = true;
    });
    if (touched) thread.addLabel(processedLabel);
  });
  setProp_('kslLastEmailAt', newest);
  if (queued) logEvent_('info', 'ksl-email', 'Queued ' + queued + ' new KSL listings');
  maybeEndAutoBackup_(newest);
  return queued;
}

/** Returns normalized items, [] if it looked like an alert but nothing parsed, or null if not an alert. */
function parseAlertMessage_(msg) {
  var html = msg.getBody(), subject = msg.getSubject(), plain = msg.getPlainBody();
  var parsed = parseKslAlertEmail_(html, subject, plain);
  if (!parsed.listings.length && parsed.unresolvedLinks.length) {
    // Click-tracking links: resolve redirects (Location header only; we never load the KSL page here).
    var replaced = html, resolved = 0;
    parsed.unresolvedLinks.slice(0, 15).forEach(function (u) {
      var target = resolveRedirect_(u);
      if (target && kslListingIdFromUrl_(target)) {
        replaced = replaced.split(u).join(target).split(u.replace(/&/g, '&amp;')).join(target);
        resolved++;
      }
    });
    if (resolved) parsed = parseKslAlertEmail_(replaced, subject, plain);
  }
  var looksLikeAlert = /DF\s*[-–]/i.test(subject + ' ' + plain) || /saved search|new listing|alert/i.test(subject);
  if (!parsed.listings.length && !looksLikeAlert) return null;
  var searchName = parsed.searchName || matchSearchName_(subject);
  var isFreeSearch = /free/i.test(searchName);
  var posted = msg.getDate().toISOString();
  return parsed.listings.map(function (it) {
    it.matched_search = searchName;
    if (it.price === null && isFreeSearch) it.price = 0;
    it.posted_at = it.posted_at || posted;
    it.email_date = posted;
    return it;
  });
}

function matchSearchName_(subject) {
  var s = String(subject || '').toLowerCase();
  var hit = getConfig_().kslSearches.filter(function (k) {
    var core = k.name.replace(/^DF\s*-\s*/i, '').toLowerCase();
    return s.indexOf(core) >= 0 || (k.keyword && s.indexOf(k.keyword.toLowerCase()) >= 0);
  })[0];
  return hit ? hit.name : '';
}

/** Follow one redirect hop and return the Location URL (or ''). */
function resolveRedirect_(url) {
  try {
    var r = UrlFetchApp.fetch(url, { followRedirects: false, muteHttpExceptions: true });
    var h = r.getAllHeaders();
    return h.Location || h.location || '';
  } catch (e) { return ''; }
}

function reportParserFailure_(msg) {
  logEvent_('error', 'ksl-email', 'KSL email format changed: 0 listings parsed from "' + msg.getSubject() + '"', '', { messageId: msg.getId() });
  if (prop_('kslParseAlertDay') !== todayKey_()) {
    setProp_('kslParseAlertDay', todayKey_());
    alert_('KSL email format changed', 'An alert email arrived ("' + truncate_(msg.getSubject(), 80) +
      '") but no listings could be read from it. Run Deal Finder → Capture KSL email samples so the parser can be updated.');
  }
}

// ---------------------------------------------------------------------------
// Feed health

/** If no alert email for KSL_HEALTH_HOURS during active hours: alert, and optionally switch on backup mode. */
function kslFeedHealthCheck_() {
  var h = localParts_().hour;
  if (!hourInRange_(h, settingNum_('KSL_HEALTH_ACTIVE_START'), settingNum_('KSL_HEALTH_ACTIVE_END'))) return;
  var last = Number(prop_('kslLastEmailAt') || 0);
  if (!last) {
    var t = GmailApp.search('label:"' + settingStr_('KSL_EMAIL_LABEL') + '"', 0, 1);
    if (t.length) { last = t[0].getLastMessageDate().getTime(); setProp_('kslLastEmailAt', last); }
  }
  var hours = (nowMs_() - last) / 3600000;
  if (last && hours < settingNum_('KSL_HEALTH_HOURS')) return;
  var msg = 'No KSL alert emails for ' + (last ? Math.round(hours) + ' hours' : 'a long time') + '. ';
  if (settingBool_('KSL_BACKUP_MODE')) {
    logEvent_('warn', 'ksl-health', msg + 'Backup collector already on.');
    return;
  }
  if (settingBool_('KSL_AUTO_BACKUP')) {
    writeSetting_('KSL_BACKUP_MODE', true);
    setProp_('kslBackupAuto', '1');
    alert_('KSL emails stopped', msg + 'Backup collector switched ON automatically. It turns itself off when emails resume.');
  } else if (prop_('kslHealthAlertAt') === '' || nowMs_() - Number(prop_('kslHealthAlertAt')) > 6 * 3600000) {
    setProp_('kslHealthAlertAt', nowMs_());
    alert_('KSL emails stopped', msg + 'Check the KSL saved searches / Gmail filter. To poll KSL directly meanwhile, set KSL_BACKUP_MODE to TRUE in Settings (or set KSL_AUTO_BACKUP to TRUE to do this automatically).');
  }
}

/** Turn backup mode off again if WE turned it on and emails are flowing again. */
function maybeEndAutoBackup_(newestEmailMs) {
  if (prop_('kslBackupAuto') !== '1' || !settingBool_('KSL_BACKUP_MODE')) return;
  if (nowMs_() - newestEmailMs < 60 * 60000) {
    writeSetting_('KSL_BACKUP_MODE', false);
    setProp_('kslBackupAuto', '');
    alert_('KSL emails resumed', 'Backup collector switched OFF again.');
  }
}

// ---------------------------------------------------------------------------
// Parser development helper (menu item)

/**
 * Save the 10 most recent KSL alert emails as .html files in a Drive folder and write what the
 * parser extracted from each into a "Parser test" tab. Use this to check or update the parser.
 */
function captureKslEmailSamples() {
  var threads = GmailApp.search('label:"' + settingStr_('KSL_EMAIL_LABEL') + '"', 0, 10);
  var root = DriveApp.getFolderById(requireProp_(PROP.DRIVE_FOLDER_ID));
  var it = root.getFoldersByName('KSL email samples');
  var folder = it.hasNext() ? it.next() : root.createFolder('KSL email samples');
  var ss = getSpreadsheet_();
  var sh = ss.getSheetByName('Parser test') || ss.insertSheet('Parser test');
  sh.clear();
  sh.appendRow(['Email date', 'Subject', 'Search name', 'Listing ID', 'Title', 'Price', 'City', 'Image', 'Unresolved links']);
  var count = 0;
  threads.forEach(function (t) {
    var msg = t.getMessages().slice(-1)[0];
    var name = Utilities.formatDate(msg.getDate(), TZ, 'yyyyMMdd-HHmm') + '-' + msg.getId() + '.html';
    folder.createFile(name, msg.getBody(), MimeType.HTML);
    var parsed = parseKslAlertEmail_(msg.getBody(), msg.getSubject(), msg.getPlainBody());
    if (!parsed.listings.length) sh.appendRow([msg.getDate(), msg.getSubject(), parsed.searchName, '(none parsed)', '', '', '', '', parsed.unresolvedLinks.length]);
    parsed.listings.forEach(function (l) {
      sh.appendRow([msg.getDate(), msg.getSubject(), parsed.searchName, l.listing_id, l.title, l.price, l.city, l.image_url, parsed.unresolvedLinks.length]);
    });
    count++;
  });
  safeAlert_('Saved ' + count + ' emails to Drive folder "KSL email samples" and wrote parse results to the "Parser test" tab.\n' + folder.getUrl());
}


// ===== KslParser.js =====
/**
 * KslParser.js: pure parsing for KSL Classifieds. No Apps Script services, so the same file runs in
 * Apps Script, in the Apify actor (copied to ksl-collector/src/kslParser.cjs) and in Node tests.
 *
 * If KSL changes its pages or alert emails, this is the file to update.
 */

var KSL_BASE = 'https://classifieds.ksl.com';

// ---------------------------------------------------------------------------
// Search-URL building (same patterns as the saved searches)

/** search: {type: 'category'|'keyword', category, subcategory, keyword, radius, maxPrice (null = none, 0 = free)} */
function kslSearchUrl_(search, zip) {
  var enc = function (s) { return encodeURIComponent(String(s).trim()).replace(/%20/g, '+'); };
  var path;
  if (search.type === 'keyword') {
    path = '/search/keyword/' + enc(search.keyword);
  } else {
    path = '/search/cat/' + enc(search.category);
    if (search.subcategory) path += '/sub/' + enc(search.subcategory);
  }
  path += '/zip/' + (zip || '84054') + '/miles/' + (search.radius || 25);
  if (search.maxPrice !== null && search.maxPrice !== undefined && search.maxPrice !== '' && Number(search.maxPrice) > 0) {
    path += '/priceFrom/0/priceTo/' + Math.round(Number(search.maxPrice));
  }
  return KSL_BASE + path;
}

// ---------------------------------------------------------------------------
// Next.js flight-data helpers

/** Concatenate the decoded strings pushed via self.__next_f.push([1,"..."]). Falls back to the raw HTML. */
function kslFlightText_(html) {
  var out = [];
  var rx = /self\.__next_f\.push\(\[1,("(?:[^"\\]|\\[\s\S])*")\]\)/g;
  var m;
  while ((m = rx.exec(html)) !== null) {
    try { out.push(JSON.parse(m[1])); } catch (e) { /* skip malformed chunk */ }
  }
  return out.length ? out.join('') : html;
}

/** Return the balanced JSON object starting at text[start] === '{', or null. */
function kslBalancedObject_(text, start) {
  var depth = 0, inStr = false, esc = false;
  for (var i = start; i < text.length; i++) {
    var c = text.charAt(i);
    if (inStr) {
      if (esc) esc = false;
      else if (c === '\\') esc = true;
      else if (c === '"') inStr = false;
      continue;
    }
    if (c === '"') inStr = true;
    else if (c === '{') depth++;
    else if (c === '}') { depth--; if (depth === 0) return text.slice(start, i + 1); }
  }
  return null;
}

function kslIsoFromEpoch_(sec) {
  return sec ? new Date(Number(sec) * 1000).toISOString() : '';
}

function kslFullImage_(url) {
  return url ? String(url).replace(/\?filter=.*$/, '') : '';
}

/** Map one listing object from KSL page data to the normalized item shape. */
function kslListingToItem_(o) {
  var loc = o.location || {};
  var coords = loc.coordinates || {};
  var img = o.primaryImage && o.primaryImage.url ? o.primaryImage.url : '';
  var photos = (o.photos || []).map(function (p) { return p && p.url; }).filter(Boolean);
  return {
    deal_id: 'ksl:' + o.id,
    source: 'KSL',
    listing_id: String(o.id),
    title: o.title || '',
    price: o.price === null || o.price === undefined ? null : Number(o.price),
    city: loc.city || '',
    state: loc.state || '',
    zip: loc.zip || '',
    lat: coords.latitude || null,
    lng: coords.longitude || null,
    url: KSL_BASE + '/listing/' + o.id,
    image_url: img,
    image_urls: photos.length ? photos.slice(0, 4) : (img ? [kslFullImage_(img)] : []),
    description: o.description || '',
    posted_at: kslIsoFromEpoch_(o.displayAt || o.createdAt),
    category_hint: [o.category, o.subCategory].filter(Boolean).join(' / '),
    condition: o.condition || o.newUsed || '',
    seller_type: o.sellerType || ''
  };
}

// ---------------------------------------------------------------------------
// Search result page

/**
 * Parse a KSL search page. Returns {listings: [item], pageInfo: {hasNextPage, endCursor, total} | null, blocked: bool}.
 */
function parseKslSearchHtml_(html) {
  var result = { listings: [], pageInfo: null, blocked: kslLooksBlocked_(html) };
  var text = kslFlightText_(html);
  var rx = /\{"id":(\d{5,}),"contact"/g;
  var seen = {}, m;
  while ((m = rx.exec(text)) !== null) {
    if (seen[m[1]]) continue;
    var raw = kslBalancedObject_(text, m.index);
    if (!raw) continue;
    try {
      var o = JSON.parse(raw);
      if (o.listingType && o.listingType !== 'CLASSIFIED') continue;
      seen[m[1]] = true;
      result.listings.push(kslListingToItem_(o));
    } catch (e) { /* not a listing object */ }
  }
  var pi = /"pageInfo":\[\{"hasNextPage":(true|false),"endCursor":"([^"]*)","total":(\d+)/.exec(text);
  if (pi) result.pageInfo = { hasNextPage: pi[1] === 'true', endCursor: pi[2], total: Number(pi[3]) };
  // Fallback: plain HTML cards (if the flight data format changes).
  if (!result.listings.length) {
    var cardRx = /data-item-id="(\d+)"[^>]*href="([^"]+)"[\s\S]*?<img[^>]*src="([^"]+)"[\s\S]*?aria-label="Price ([^"]*)"/g;
    while ((m = cardRx.exec(html)) !== null) {
      var label = /aria-label="([^"]*)" data-item-id="/.exec(html.slice(Math.max(0, m.index - 300), m.index + 40));
      result.listings.push({
        deal_id: 'ksl:' + m[1], source: 'KSL', listing_id: m[1], title: label ? kslDecodeEntities_(label[1]) : '',
        price: kslPrice_(m[4]), city: '', url: KSL_BASE + '/listing/' + m[1], image_url: m[3], image_urls: [m[3]], description: '', posted_at: ''
      });
    }
  }
  return result;
}

// ---------------------------------------------------------------------------
// Listing detail page

/** Returns the normalized item (with description, photos, coordinates) or null. */
function parseKslDetailHtml_(html) {
  var text = kslFlightText_(html);
  var idx = text.indexOf('"listing":{"id":');
  if (idx >= 0) {
    var raw = kslBalancedObject_(text, idx + '"listing":'.length);
    if (raw) {
      try { return kslListingToItem_(JSON.parse(raw)); } catch (e) { /* fall through */ }
    }
  }
  // Fallback: schema.org Product JSON-LD
  var ld = /<script type="application\/ld\+json">(\{"@context":"https:\/\/schema\.org","@type":"Product"[\s\S]*?)<\/script>/.exec(html);
  if (ld) {
    try {
      var p = JSON.parse(ld[1]);
      return {
        deal_id: 'ksl:' + p.sku, source: 'KSL', listing_id: String(p.sku), title: p.name, price: p.offers ? Number(p.offers.price) : null,
        url: p.url, image_url: p.image && p.image.url, image_urls: p.image && p.image.url ? [p.image.url] : [], description: '', city: '', posted_at: ''
      };
    } catch (e) { /* ignore */ }
  }
  return null;
}

// ---------------------------------------------------------------------------
// Block / CAPTCHA detection (shared by Apps Script and the actor)

function kslLooksBlocked_(html) {
  var s = String(html || '').slice(0, 20000).toLowerCase();
  return /captcha|cf-chl|challenge-platform|px-captcha|access denied|request unsuccessful|are you a robot|unusual traffic|perimeterx|datadome/.test(s) &&
    s.indexOf('search-result') < 0 && s.indexOf('"listing":{') < 0;
}

// ---------------------------------------------------------------------------
// robots.txt

/**
 * Minimal robots.txt check. Uses the group for our user-agent token, else '*'. No group = allowed.
 * Longest matching rule wins; Allow wins ties.
 */
function kslRobotsAllows_(robotsTxt, userAgent, path) {
  var groups = [], cur = null, lastWasUa = false;
  String(robotsTxt || '').split(/\r?\n/).forEach(function (line) {
    line = line.replace(/#.*$/, '').trim();
    var m = /^([A-Za-z-]+)\s*:\s*(.*)$/.exec(line);
    if (!m) return;
    var field = m[1].toLowerCase(), value = m[2].trim();
    if (field === 'user-agent') {
      if (!lastWasUa || !cur) { cur = { agents: [], rules: [] }; groups.push(cur); }
      cur.agents.push(value.toLowerCase());
      lastWasUa = true;
    } else {
      lastWasUa = false;
      if (cur && (field === 'allow' || field === 'disallow')) cur.rules.push({ allow: field === 'allow', path: value });
    }
  });
  var token = String(userAgent || '').split(/[\/\s]/)[0].toLowerCase();
  var group = null;
  groups.forEach(function (g) { if (!group && g.agents.some(function (a) { return a !== '*' && token.indexOf(a) === 0; })) group = g; });
  if (!group) groups.forEach(function (g) { if (!group && g.agents.indexOf('*') >= 0) group = g; });
  if (!group) return true;
  var best = null;
  group.rules.forEach(function (r) {
    if (!r.path) return; // "Disallow:" with empty value allows everything
    var rx = new RegExp('^' + r.path.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*').replace(/\\\$$/, '$'));
    if (rx.test(path)) {
      if (!best || r.path.length > best.path.length || (r.path.length === best.path.length && r.allow)) best = r;
    }
  });
  return best ? best.allow : true;
}

// ---------------------------------------------------------------------------
// Alert email parsing

function kslDecodeEntities_(s) {
  return String(s || '')
    .replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&').replace(/&quot;/gi, '"').replace(/&#39;|&apos;/gi, "'")
    .replace(/&lt;/gi, '<').replace(/&gt;/gi, '>').replace(/&#(\d+);/g, function (_, n) { return String.fromCharCode(Number(n)); })
    .replace(/&#x([0-9a-f]+);/gi, function (_, n) { return String.fromCharCode(parseInt(n, 16)); });
}

function kslStripTags_(html) {
  return kslDecodeEntities_(String(html || '')
    .replace(/<(script|style|head)[\s\S]*?<\/\1>/gi, ' ')
    .replace(/<br\s*\/?>/gi, '\n').replace(/<\/(p|div|tr|td|li|h\d|table)>/gi, '\n')
    .replace(/<[^>]+>/g, ' '))
    .replace(/[ \t]+/g, ' ').replace(/\n\s*/g, '\n').trim();
}

function kslPrice_(s) {
  s = String(s || '');
  if (/\bfree\b/i.test(s)) return 0;
  var m = /\$\s?([\d,]+(?:\.\d{1,2})?)/.exec(s);
  return m ? Number(m[1].replace(/,/g, '')) : null;
}

/** Find a KSL listing ID inside a (possibly tracking-wrapped, URL-encoded) link. */
function kslListingIdFromUrl_(url) {
  var u = kslDecodeEntities_(url);
  for (var i = 0; i < 3; i++) {
    var m = /classifieds\.ksl\.com(?:\/|%2F)+listing(?:\/|%2F)+(\d{5,})/i.exec(u) || /\/listing\/(\d{5,})\b/.exec(u) ||
      /[?&](?:listingId|listing_id|adId|ad_id|id)=(\d{6,})\b/i.exec(u);
    if (m) return m[1];
    try { var d = decodeURIComponent(u); if (d === u) break; u = d; } catch (e) { break; }
  }
  return null;
}

/** "DF - Tools <$100" from subject or body; '' if not found. */
function kslSearchName_(subject, text) {
  var hay = kslDecodeEntities_(String(subject || '') + '\n' + String(text || ''));
  var m = /DF\s*[-–]\s*([^\n"|]{2,60}?)(?=\s*(?:\n|"|$|\||has |have |new |matches|listing|alert|saved search))/i.exec(hay) ||
    /DF\s*[-–]\s*([^\n"]{2,60})/i.exec(hay);
  return m ? ('DF - ' + m[1].trim()).replace(/[.:,;!]+$/, '') : '';
}

var KSL_IMG_SKIP_RX = /logo|icon|spacer|pixel|blank|tracking|open\?|beacon|facebook|twitter|instagram|youtube|app-?store|google-?play|badge|\.gif(\?|$)/i;

/**
 * Parse one KSL alert email. Returns {searchName, listings: [item], unresolvedLinks: [url]}.
 * unresolvedLinks: tracking links with no visible listing ID (the caller may resolve redirects).
 */
function parseKslAlertEmail_(html, subject, plainText) {
  html = String(html || '');
  var out = { searchName: kslSearchName_(subject, kslStripTags_(html) + '\n' + (plainText || '')), listings: [], unresolvedLinks: [] };
  var anchors = [];
  var aRx = /<a\b[^>]*href\s*=\s*["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi;
  var m;
  while ((m = aRx.exec(html)) !== null) anchors.push({ href: m[1], inner: m[2], start: m.index, end: m.index + m[0].length });

  // First anchor position per listing ID, in document order.
  var order = [], firstPos = {}, anchorText = {};
  anchors.forEach(function (a) {
    var id = kslListingIdFromUrl_(a.href);
    if (!id) {
      if (/^https?:/i.test(a.href) && !/unsubscribe|mailto:|preferences|privacy|terms|help|\/myaccount|\/saved-searches|ksl\.com\/?$/i.test(a.href)) {
        out.unresolvedLinks.push(kslDecodeEntities_(a.href));
      }
      return;
    }
    if (firstPos[id] === undefined) { firstPos[id] = a.start; order.push(id); }
    var t = kslStripTags_(a.inner).replace(/\s+/g, ' ').trim();
    if (t && !/^(view|see|open)( listing| details| it| now)?$|^\$|^free$/i.test(t) && (!anchorText[id] || t.length > anchorText[id].length)) anchorText[id] = t;
  });

  order.forEach(function (id, idx) {
    var start = firstPos[id];
    var end = idx + 1 < order.length ? firstPos[order[idx + 1]] : html.length;
    // Images often sit just before the first link of a card: look back a little, but not past the previous card.
    var prevEnd = idx > 0 ? firstPos[order[idx - 1]] : 0;
    var lookback = Math.max(prevEnd, start - 600);
    var block = html.slice(start, Math.min(end, start + 8000));
    var pre = html.slice(lookback, start);
    var text = kslStripTags_(block);
    var lines = text.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);

    var img = '';
    var imgRx = /<img\b[^>]*src\s*=\s*["']([^"']+)["'][^>]*>/gi, im;
    var candidates = [];
    while ((im = imgRx.exec(block)) !== null) candidates.push(im);
    var preImgs = [];
    while ((im = imgRx.exec(pre)) !== null) preImgs.push(im);
    candidates = candidates.concat(preImgs.reverse());
    for (var c = 0; c < candidates.length; c++) {
      var tag = candidates[c][0], src = kslDecodeEntities_(candidates[c][1]);
      if (KSL_IMG_SKIP_RX.test(src) || /width=["']?1["']?\b|height=["']?1["']?\b/i.test(tag)) continue;
      img = src; break;
    }

    var title = anchorText[id] || '';
    if (!title) {
      for (var li = 0; li < lines.length; li++) {
        var l = lines[li];
        if (kslPrice_(l) !== null && l.length < 20) continue;
        if (/^(view|see|open)\b/i.test(l)) continue;
        title = l; break;
      }
    }
    var priceLine = lines.filter(function (l) { return /\$\s?\d|\bfree\b/i.test(l) && l.length < 40; })[0];
    var price = priceLine ? kslPrice_(priceLine) : null;
    var cityM = /\b([A-Z][A-Za-z.'\- ]{1,30}),\s*(UT|Utah|ID|Idaho|NV|WY)\b/.exec(text);
    var timeM = /\b(\d+\s+(?:minute|min|hour|hr|day)s?\s+ago|just now|today|yesterday)\b/i.exec(text);
    out.listings.push({
      deal_id: 'ksl:' + id,
      source: 'KSL',
      listing_id: id,
      title: title,
      price: price,
      city: cityM ? cityM[1].trim() : '',
      state: cityM ? (cityM[2].length === 2 ? cityM[2] : '') : '',
      url: KSL_BASE + '/listing/' + id,
      image_url: img,
      image_urls: img ? [img] : [],
      description: '',
      posted_text: timeM ? timeM[1] : '',
      matched_search: out.searchName
    });
  });
  return out;
}

if (typeof module !== 'undefined' && module.exports) {
  module.exports = {
    kslSearchUrl_: kslSearchUrl_, parseKslSearchHtml_: parseKslSearchHtml_, parseKslDetailHtml_: parseKslDetailHtml_,
    parseKslAlertEmail_: parseKslAlertEmail_, kslRobotsAllows_: kslRobotsAllows_, kslLooksBlocked_: kslLooksBlocked_,
    kslListingIdFromUrl_: kslListingIdFromUrl_, kslSearchName_: kslSearchName_, kslPrice_: kslPrice_
  };
}


// ===== Listing.js =====
/**
 * Listing.js: on-demand resale listing drafts from your own photos (never auto-posts).
 */

var DRAFT_ALLOWED_STATUSES = ['Picked Up', 'Repairing', 'Listed'];

/** Fetch a Drive image as a JPEG of reasonable size (Drive's thumbnail service also converts HEIC). */
function drivePhotoBlob_(file) {
  try {
    var r = UrlFetchApp.fetch('https://drive.google.com/thumbnail?id=' + file.getId() + '&sz=w1568', {
      headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true
    });
    if (r.getResponseCode() === 200 && /^image\//.test(r.getBlob().getContentType())) return r.getBlob().setName(file.getName());
  } catch (e) { /* fall back */ }
  var type = file.getMimeType();
  if (/^image\/(jpeg|png|webp|gif)$/.test(type) && file.getSize() < 4.5 * 1024 * 1024) return file.getBlob();
  return null;
}

/** Returns {ok, docUrl, ksl, facebook, photo_order, retakes} or {ok:false, error}. */
function draftListingFor_(dealId, notes) {
  var f = findDealRow_(dealId);
  if (!f) return { ok: false, error: 'Deal not found' };
  var deal = dealRowToObject_(f.values);
  if (DRAFT_ALLOWED_STATUSES.indexOf(deal.status) < 0) {
    return { ok: false, error: 'Set the status to Picked Up, Repairing or Listed first (it is "' + (deal.status || 'New') + '").' };
  }
  var folder = ensureDealFolder_(f.row);
  var photos = [];
  var files = folder.getFiles();
  while (files.hasNext() && photos.length < 8) {
    var file = files.next();
    if (!/^image\//.test(file.getMimeType())) continue;
    var blob = drivePhotoBlob_(file);
    if (blob) photos.push({ name: file.getName(), blob: blob });
  }
  if (!photos.length) {
    return { ok: false, error: 'No photos yet. Upload your photos to the item folder first: ' + folder.getUrl(), folder: folder.getUrl() };
  }
  var d = aiDraftListing_(deal, photos, notes);

  var doc = DocumentApp.create('Listing draft – ' + truncate_(deal.title, 60));
  var bodyEl = doc.getBody();
  bodyEl.appendParagraph('Listing drafts: ' + deal.title).setHeading(DocumentApp.ParagraphHeading.TITLE);
  bodyEl.appendParagraph('Generated ' + fmtTime_() + '. Review before posting; nothing is posted automatically.').setItalic(true);
  [['KSL Classifieds', d.ksl], ['Facebook Marketplace', d.facebook]].forEach(function (pair) {
    var x = pair[1];
    bodyEl.appendParagraph(pair[0]).setHeading(DocumentApp.ParagraphHeading.HEADING1);
    bodyEl.appendParagraph('Title: ' + x.title).setItalic(false);
    bodyEl.appendParagraph('Price: $' + x.price + '  ·  Category: ' + x.category);
    bodyEl.appendParagraph('Pricing: ' + x.pricing_guidance);
    bodyEl.appendParagraph(x.description);
  });
  bodyEl.appendParagraph('Photo order').setHeading(DocumentApp.ParagraphHeading.HEADING1);
  d.photo_order.forEach(function (n, i) { bodyEl.appendListItem((i + 1) + '. ' + n); });
  if (d.retakes.length) {
    bodyEl.appendParagraph('Retakes / extra shots').setHeading(DocumentApp.ParagraphHeading.HEADING1);
    d.retakes.forEach(function (r) { bodyEl.appendListItem(r); });
  }
  doc.saveAndClose();
  var docFile = DriveApp.getFileById(doc.getId());
  docFile.moveTo(folder);
  setDealField_(f.row, 'draft_url', doc.getUrl());
  logEvent_('info', 'draft', 'Drafted listing for ' + deal.title);
  return { ok: true, docUrl: doc.getUrl(), ksl: d.ksl, facebook: d.facebook, photo_order: d.photo_order, retakes: d.retakes, folder: folder.getUrl() };
}


// ===== Main.js =====
/**
 * Main.js: the scheduler. A single time trigger calls tick() every 5 minutes; tick decides what is due
 * using the Settings tab, so schedules change without recreating triggers.
 */

function tick() {
  var started = nowMs_();
  // Free Google accounts get 90 min/day of trigger runtime: overnight (quiet hours) run every 15 min only.
  if (isQuietHours_() && nowMs_() - Number(prop_('lastTickAt') || 0) < 14 * 60000 && queueLength_() === 0) return;
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) { console.log('tick: previous tick still running'); return; }
  setProp_('lastTickAt', started);
  resetConfigCache_();
  try {
    runJob_('notify', releaseHeldNotifications_);
    runJob_('apify-poll', pollApifyRuns_);
    runJob_('ksl-email', kslEmailIntake_);
    runJob_('queue', function () { processQueue_(started); }); // free KSL items get scored right away
    runScheduledJobs_();
    if (nowMs_() - started < TICK_BUDGET_MS) runJob_('queue', function () { processQueue_(started); });
  } finally {
    lock.releaseLock();
    var prev = (prop_('count:runtimeSec') || '').split('|');
    if (prev[0] && prev[0] !== todayKey_()) setProp_('runtimeYesterday', prev[1]); // first tick of a new day
    var secs = bumpDaily_('runtimeSec', Math.round((nowMs_() - started) / 1000));
    if (secs > 75 * 60 && prop_('runtimeAlertDay') !== todayKey_()) {
      setProp_('runtimeAlertDay', todayKey_());
      alert_('Apps Script runtime high', 'Triggers ran ' + Math.round(secs / 60) + ' min today (free Google accounts allow 90). Consider raising FB_FREE_INTERVAL_MIN or lowering SONNET_DAILY_CAP.');
    }
  }
}

function runJob_(name, fn) {
  try { fn(); } catch (e) { logEvent_('error', name, e.message + (e.stack ? ' | ' + truncate_(e.stack, 500) : '')); }
}

function runScheduledJobs_() {
  var h = localParts_().hour;

  // Facebook free sweep: every N minutes during active hours.
  if (hourInRange_(h, settingNum_('FB_FREE_ACTIVE_START'), settingNum_('FB_FREE_ACTIVE_END')) &&
      intervalDue_('lastFbFree', Math.max(15, settingNum_('FB_FREE_INTERVAL_MIN')))) {
    markInterval_('lastFbFree');
    runJob_('fb-free', facebookFreeSweep_);
  }

  // Facebook paid sweeps at set times.
  dueSlots_(settingTimes_('FB_PAID_TIMES'), 'slotFbPaid:').forEach(function (slot) {
    slot.markDone();
    runJob_('fb-paid', facebookPaidSweep_);
  });

  // KSL feed health check.
  if (intervalDue_('lastKslHealth', settingNum_('KSL_HEALTH_INTERVAL_MIN') || 120)) {
    markInterval_('lastKslHealth');
    runJob_('ksl-health', kslFeedHealthCheck_);
  }

  // KSL backup mode (only when the email feed is broken or the toggle is on).
  if (settingBool_('KSL_BACKUP_MODE')) {
    if (intervalDue_('lastKslBackupFree', settingNum_('KSL_BACKUP_FREE_INTERVAL_MIN') || 20)) {
      markInterval_('lastKslBackupFree');
      runJob_('ksl-backup', function () { kslBackupPoll_('free'); });
    }
    dueSlots_(settingTimes_('KSL_BACKUP_PAID_TIMES'), 'slotKslPaid:').forEach(function (slot) {
      slot.markDone();
      runJob_('ksl-backup', function () { kslBackupPoll_('paid'); });
    });
  }

  // Baseline that didn't fit in one day's page cap continues the next morning.
  if (prop_('kslBaselineRemaining') && prop_('kslBaselineRemaining') !== '[]' && h >= 6 && prop_('kslBaselineContinued') !== todayKey_()) {
    setProp_('kslBaselineContinued', todayKey_());
    runJob_('ksl-baseline', continueKslBaseline_);
  }

  // Digests.
  dueSlots_(settingTimes_('DIGEST_TIMES'), 'slotDigest:').forEach(function (slot) {
    slot.markDone();
    runJob_('digest', function () { sendDigest_(slot.time === settingStr_('TOP10_DIGEST_TIME')); });
  });
  if (prop_('baselineDigestPending') === '1') runJob_('digest', sendBaselineDigestIfReady_);

  // Daily housekeeping.
  dueSlots_(['03:00'], 'slotHousekeeping:').forEach(function (slot) {
    slot.markDone();
    runJob_('housekeeping', housekeeping_);
  });
}

// ---------------------------------------------------------------------------
// Digests

/** Push held paid deals (and on the evening slot, the top 10 of the day) as one summary. */
function sendDigest_(includeTop10) {
  var sh = getSheet_(SHEETS.DEALS);
  if (sh.getLastRow() < 2) return;
  var data = sh.getRange(2, 1, sh.getLastRow() - 1, DEAL_COLS.length).getValues();
  var col = function (k) { return dealColIndex_(k) - 1; };
  var pending = [], today = [];
  var todayStr = todayKey_();
  data.forEach(function (r, i) {
    if (r[col('notified')] === 'digest') pending.push({ row: i + 2, r: r });
    var d = r[col('date_found')];
    if (d instanceof Date && Utilities.formatDate(d, TZ, 'yyyy-MM-dd') === todayStr && r[col('notified')] !== 'baseline') today.push(r);
  });
  var byScore = function (a, b) { return (b.r || b)[col('opportunity_score')] - (a.r || a)[col('opportunity_score')]; };
  pending.sort(byScore);
  var line = function (r) {
    return '• ' + r[col('opportunity_score')] + '/10 ' + truncate_(r[col('title')], 50) + ' · ' + (r[col('price')] === 0 ? 'FREE' : '$' + r[col('price')]) +
      ' · +$' + Math.round(r[col('est_profit')] || 0) + (r[col('distance_miles')] !== '' ? ' · ' + r[col('distance_miles')] + 'mi' : '');
  };
  var parts = [];
  var worth = pending.filter(function (p) { return p.r[col('opportunity_score')] >= 5; });
  if (worth.length) parts.push('**New since last digest (' + worth.length + ')**\n' + worth.slice(0, 8).map(function (p) { return line(p.r); }).join('\n'));
  if (includeTop10 && today.length) {
    today.sort(byScore);
    parts.push('**Top ' + Math.min(10, today.length) + ' today**\n' + today.slice(0, 10).map(line).join('\n'));
  }
  pending.forEach(function (p) { sh.getRange(p.row, dealColIndex_('notified')).setValue('digest-sent'); });
  if (includeTop10) sortDeals_();
  if (!parts.length) return;
  notify_({ title: includeTop10 ? '📋 Evening deal digest' : '📋 Deal digest', body: parts.join('\n\n'), clickUrl: dashboardUrl_(), priority: 3, tags: ['clipboard'] });
}

function sortDeals_() {
  var sh = getSheet_(SHEETS.DEALS);
  if (sh.getLastRow() < 3) return;
  sh.getRange(2, 1, sh.getLastRow() - 1, DEAL_COLS.length)
    .sort([{ column: dealColIndex_('opportunity_score'), ascending: false }, { column: dealColIndex_('date_found'), ascending: false }]);
}

/** One-time "Baseline results" digest, sent once every baseline item has been scored. */
function sendBaselineDigestIfReady_() {
  var q = getSheet_(SHEETS.QUEUE);
  if (q.getLastRow() > 1) {
    var stillQueued = q.getRange(2, 4, q.getLastRow() - 1, 1).getValues().some(function (r) { return String(r[0]).indexOf('"baseline":true') >= 0; });
    if (stillQueued) return;
  }
  setProp_('baselineDigestPending', '');
  var sh = getSheet_(SHEETS.DEALS);
  var data = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, DEAL_COLS.length).getValues() : [];
  var col = function (k) { return dealColIndex_(k) - 1; };
  var base = data.filter(function (r) { return r[col('notified')] === 'baseline'; })
    .sort(function (a, b) { return b[col('opportunity_score')] - a[col('opportunity_score')]; });
  var body = base.length
    ? base.slice(0, 12).map(function (r) {
        return '• ' + r[col('opportunity_score')] + '/10 ' + truncate_(r[col('title')], 50) + ' · ' + (r[col('price')] === 0 ? 'FREE' : '$' + r[col('price')]) + ' · +$' + Math.round(r[col('est_profit')] || 0);
      }).join('\n') + '\n\nAll ' + base.length + ' are on the dashboard (filter Source = KSL (baseline)).'
    : 'No keepers in the existing KSL listings.';
  notify_({ title: '📦 KSL baseline results', body: body, clickUrl: dashboardUrl_(), priority: 3, tags: ['package'] });
}

