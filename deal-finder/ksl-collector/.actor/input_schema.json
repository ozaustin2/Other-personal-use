{
  "title": "KSL collector input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "search = run the searches; details = fetch single listing pages listed in detailIds.",
      "editor": "select",
      "enum": ["search", "details"],
      "default": "search"
    },
    "zip": { "title": "Home ZIP", "type": "string", "editor": "textfield", "default": "84054" },
    "searches": {
      "title": "Searches",
      "type": "array",
      "description": "[{name, type: category|keyword, category, subcategory, keyword, radius, maxPrice (null = none, 0 = free), maxPages, stopAtIds}]",
      "editor": "json",
      "prefill": [{ "name": "DF - Free 25mi", "type": "category", "category": "FREE", "radius": 25, "maxPrice": 0, "maxPages": 1, "stopAtIds": [] }]
    },
    "detailIds": { "title": "Listing IDs for details mode", "type": "array", "editor": "stringList", "default": [] },
    "maxPageLoads": { "title": "Max page loads this run", "type": "integer", "default": 20, "minimum": 1, "maximum": 200 },
    "maxDetailPages": { "title": "Max detail pages this run", "type": "integer", "default": 0, "minimum": 0, "maximum": 30 },
    "sinceDays": { "title": "Skip listings older than N days (0 = no limit)", "type": "integer", "default": 0, "minimum": 0 },
    "minDelaySecs": { "title": "Min delay between requests (s)", "type": "integer", "default": 3, "minimum": 3 },
    "maxDelaySecs": { "title": "Max delay between requests (s)", "type": "integer", "default": 8, "minimum": 3 },
    "userAgent": {
      "title": "User agent",
      "type": "string",
      "editor": "textfield",
      "default": "DealFinder-personal/1.0 (personal low-volume deal alerts; one request at a time)"
    }
  },
  "required": ["searches"]
}
