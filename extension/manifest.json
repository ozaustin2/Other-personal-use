{
  "manifest_version": 3,
  "name": "Readout: Read Aloud with OpenAI voices",
  "short_name": "Readout",
  "version": "1.0.0",
  "description": "Speechify-style read-aloud for any web page, selection, image, or area of the screen, using your OpenAI API key.",
  "permissions": ["storage", "contextMenus", "offscreen", "scripting", "activeTab", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Readout",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["shared.js", "content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "read-page": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Read the selected text, or the whole page" },
    "toggle-play": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Play / pause" },
    "read-area": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Read an area of the screen (screenshot to text)" },
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+O" } }
  }
}
